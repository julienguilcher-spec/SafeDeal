# --- Claude (génération des fiches, flashcards, quiz, réponses) ---
ANTHROPIC_API_KEY=sk-ant-...
# KCL_MODEL=claude-opus-5-5
# Modèle bon marché pour les tâches annexes (reformulation des requêtes)
# KCL_FAST_MODEL=claude-sonnet-5-5
# Profondeur de réflexion : low | medium | high | xhigh | max
# KCL_EFFORT=high
# Langue des fiches et des réponses (les termes techniques restent en anglais)
# KCL_LANG=français

# --- KEATS (le Moodle de KCL) ---
# KEATS_URL=https://keats.kcl.ac.uk
# Jeton web service. Le plus simple : `npm run kcl -- login` le demande et le
# stocke dans data/auth.json (chmod 600). Le mettre ici est une alternative.
# KEATS_TOKEN=
# Requêtes simultanées vers le serveur de la fac : inutile de monter plus haut.
# KEATS_CONCURRENCY=3
# KEATS_MAX_FILE_MB=80

# --- Réglages fins ---
# Un PDF sous ces deux limites est envoyé tel quel à Claude (il voit alors les
# schémas et les courbes). Au-delà, c'est le texte extrait qui part.
# KCL_MAX_PDF_MB=20
# KCL_MAX_PDF_PAGES=300
# Découpage pour la recherche
# KCL_CHUNK_CHARS=4800
# KCL_CHUNK_OVERLAP=600
# Nombre de passages envoyés à Claude pour une question
# KCL_TOP_K=12
# Où tout est stocké (cours téléchargés, index, fiches produites)
# KCL_DATA_DIR=./data
