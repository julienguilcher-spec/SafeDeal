# --- Claude (scoring) ---
ANTHROPIC_API_KEY=sk-ant-...
# SCOUT_MODEL=claude-opus-5

# --- Sources (at least one) ---
# Apollo.io: Settings > Integrations > API. People Search does not consume enrichment credits.
APOLLO_API_KEY=
# APOLLO_LOCATIONS=Paris, France
# APOLLO_ENRICH=1   # spend 1 credit per Apollo profile that Google cannot resolve

# Google Programmable Search: create an engine at https://programmablesearchengine.google.com
# with "Search the entire web" ON, then an API key in Google Cloud (Custom Search JSON API).
# Free tier = 100 queries/day; one recipe = 2 queries by default.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- Email digest (Gmail: create an App Password, not your real password) ---
DIGEST_TO=founder@example.com
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# DIGEST_FROM=you@gmail.com

# --- Tuning ---
# SCOUT_CAMPAIGN_END=2026-11-10
# SCOUT_SHORTLIST_SIZE=5
# SCOUT_MIN_SCORE=60
# SCOUT_RECIPES_PER_DAY=3
# SCOUT_MAX_TO_SCORE=40
