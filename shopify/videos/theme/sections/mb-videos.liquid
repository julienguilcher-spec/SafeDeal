{%- liquid
  assign s = section.settings
-%}
<section class="mb-section mb-videos" style="background: {{ s.background_color | default: 'transparent' }};" id="mb-videos-{{ section.id }}">
  <div class="mb-inner">
    {%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
      <div class="mb-videos__head">
        {%- if s.eyebrow != blank -%}<p class="mb-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="mb-title mb-title--lg">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="mb-text mb-text--muted mb-videos__text">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="mb-videos__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if b.youtube_id == blank -%}{%- continue -%}{%- endif -%}
        <div class="mb-video" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="mb-video__facade"
            data-mb-video
            data-youtube-id="{{ b.youtube_id | escape }}"
            aria-label="Lire la vidéo : {{ b.heading | strip_html | escape }}"
          >
            <img
              src="https://i.ytimg.com/vi/{{ b.youtube_id | escape }}/hqdefault.jpg"
              alt=""
              loading="lazy"
              width="480"
              height="360"
              class="mb-video__thumb"
            >
            <span class="mb-video__play" aria-hidden="true">
              <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="31"/><path d="M26 20l20 12-20 12z"/></svg>
            </span>
          </button>
          {%- if b.heading != blank or b.source != blank -%}
            <div class="mb-video__legend">
              {%- if b.heading != blank -%}<p class="mb-video__title">{{ b.heading | escape }}</p>{%- endif -%}
              {%- if b.source != blank -%}<p class="mb-video__source">{{ b.source | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if s.note != blank -%}<p class="mb-videos__note">{{ s.note | escape }}</p>{%- endif -%}
  </div>
</section>
<script src="{{ 'mb-videos.js' | asset_url }}" defer></script>

{% stylesheet %}
  .mb-videos { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .mb-videos__head { max-width: 62ch; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .mb-videos__text { margin-top: 1rem; }

  .mb-videos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1rem, 2.4vw, 1.8rem);
  }

  .mb-video { display: flex; flex-direction: column; gap: 0.7rem; }

  /* Un simple bouton habillé en vignette : rien ne charge de chez YouTube
     tant qu'on n'a pas cliqué, pas même un cookie. */
  .mb-video__facade {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9;
    padding: 0; border: 0; overflow: hidden; background: var(--mb-ink, #211714);
    cursor: pointer;
  }
  .mb-video__thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .mb-video__facade:hover .mb-video__thumb { transform: scale(1.03); }
  .mb-video__facade::after { content: ''; position: absolute; inset: 0; background: rgba(20, 16, 13, 0.18); }

  .mb-video__play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: clamp(44px, 8vw, 60px); height: clamp(44px, 8vw, 60px); z-index: 1;
  }
  .mb-video__play svg { width: 100%; height: 100%; }
  .mb-video__play circle { fill: rgba(20, 16, 13, 0.55); }
  .mb-video__play path { fill: #f7efe4; }
  .mb-video__facade:hover .mb-video__play circle,
  .mb-video__facade:focus-visible .mb-video__play circle { fill: var(--mb-bordeaux, #6b1f2a); }

  /* Une fois lancée, la vidéo occupe exactement la place de la vignette. */
  .mb-video__player { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .mb-video__player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .mb-video__title { font-family: var(--mb-serif); font-size: 1.02rem; line-height: 1.35; color: var(--mb-ink); margin: 0; }
  .mb-video__source {
    font-family: var(--mb-mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--mb-muted); margin: 0.3rem 0 0;
  }

  .mb-videos__note {
    margin: clamp(1.6rem, 3vw, 2.4rem) 0 0; font-family: var(--mb-serif); font-size: 0.92rem; line-height: 1.55;
    color: var(--mb-muted); max-width: 62ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MB · Vidéos",
  "tag": "section",
  "class": "mb-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "En vidéo" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "note", "label": "Note sous les vidéos" },
    { "type": "color", "id": "background_color", "label": "Couleur de fond" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vidéo",
      "settings": [
        { "type": "text", "id": "youtube_id", "label": "Identifiant YouTube", "info": "La partie après « v= » dans l'adresse de la vidéo" },
        { "type": "text", "id": "heading", "label": "Titre affiché" },
        { "type": "text", "id": "source", "label": "Source (facultatif)", "default": "Olio Piro" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "MB · Vidéos", "category": "Maison Bosoni" } ]
}
{% endschema %}
