+import { it } from 'vitest';
+import type { Vehicle } from '@/core/contracts';
+import { createTestContext } from '@/core/testing';
+import { createSystems as world } from '@/world/query';
+import { createSystems as roles } from '@/sim/roles';
+import { createSystems as people } from '@/sim/people';
+import { createSystems as vehicles } from '@/sim/vehicles';
+import { createSystems as traffic } from '@/sim/traffic';
+import { createSystems as crowd } from '@/sim/crowd';
+import { createSystems as police } from '@/sim/police';
+import { createSystems as items } from '@/sim/items';
+import { createSystems as props } from '@/sim/props';
+import { createSystems as hazards } from '@/sim/hazards';
+import { createSystems as law } from '@/gameplay/law';
+import { createSystems as radio } from '@/gameplay/radio';
+import { createSystems as session } from '@/gameplay/session';
+import { JOURNEE_SERVICE, SERVICE_BASES } from '@/gameplay/session';
+import type { JourneeApi } from '@/gameplay/session';
+const SIM = [world, roles, people, vehicles, traffic, crowd, police, items, props, hazards, law, radio, session];
+const B = Number(process.env.DB ?? 5), SEED = Number(process.env.DSEED ?? 8), ROLE = process.env.DROLE ?? 'chef_groupe';
+const DESTS: [string, number, number][] = [['Place de la République', 3123, -208], ['Place de la Concorde', -10, 15], ['Place de la Bastille', 3542, 1395]];
+const D = Number(process.env.DD ?? 2);
+it('diag', async () => {
+  const base = SERVICE_BASES[B]!; const [place, px, pz] = DESTS[D]!;
+  const MEANS = { sections: 1, fourgons: 3, centaure: 0, canon_eau: 0, bravm: 0, drone: 0, pompiers: 0, samu: 0, secours_sur_appel: true };
+  const t = createTestContext({ seed: SEED, strict: false, modules: SIM });
+  await t.start({ mode: 'libre', role: ROLE, place, x: px, z: pz, crowdSize: 120, tension: 0.2, volatility: 0.2, duration: 'standard', extra: { moyens: MEANS, journee: true, base: { x: base.x, z: base.z, name: base.name } } } as never);
+  const { ctx } = t;
+  const j = ctx.service<JourneeApi>(JOURNEE_SERVICE)!;
+  const ap = ctx.service<any>('vehicles.autopilot')!;
+  const cmd = ctx.service<any>('police.command')!;
+  const me = ctx.player.person()!;
+  t.step(12);
+  let mine: Vehicle | undefined = me.vehicleId !== 0 ? ctx.vehicles.get(me.vehicleId) : undefined;
+  if (mine && mine.seats[0] === me.id) { ctx.vehicles.exit(me); mine = undefined; }
+  if (!mine) {
+    const v = ctx.vehicles.list.filter((v) => v.faction === 'police' && !v.def.flying && v.seats[0] !== 0 && v.seats[0] !== me.id && v.kind !== 'moto_bravm' && v.seats.some((id, i) => id === 0 && i > 0 && v.def.seats[i]?.role === 'passenger')).sort((a, b) => Math.hypot(a.x - me.x, a.z - me.z) - Math.hypot(b.x - me.x, b.z - me.z))[0]!;
+    me.x = v.x + 2.5; me.z = v.z; ctx.vehicles.enter(me, v, 'passenger'); mine = v;
+  }
+  const crewed = ctx.vehicles.list.filter((v) => v.faction === 'police' && !v.def.flying && v.seats[0] !== 0 && Math.hypot(v.x - base.x, v.z - base.z) < 300 && v.kind !== 'moto_bravm');
+  let last = '';
+  const orig = ap.driveTo.bind(ap);
+  ap.driveTo = (v: any, x: number, z: number, o: any) => { if (v.id === Number(process.env.DWATCH ?? 0) && ctx.clock.now > Number(process.env.DT0 ?? 0)) console.log('DRIVETO', ctx.clock.now.toFixed(1), x.toFixed(0), z.toFixed(0), JSON.stringify(o ?? {}).slice(0, 80), new Error().stack!.split('\n').slice(2, 6).join(' / ')); return orig(v, x, z, o); };
+  const origStop = ap.stop.bind(ap);
+  ap.stop = (v: any) => { if (v.id === Number(process.env.DWATCH ?? 0) && ctx.clock.now > Number(process.env.DT0 ?? 0)) console.log('STOP', ctx.clock.now.toFixed(1), new Error().stack!.split('\n').slice(2, 5).join(' / ')); return origStop(v); };
+  for (let i = 0; i < 400 && j.stage !== 'sur_place'; i++) {
+    for (let q = 0; q < 10; q++) {
