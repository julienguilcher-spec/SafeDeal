+      for (const v of crewed) {
+        const st = ap.status(v);
+        const a = ap.k.rt(v).ap;
+        if (a && (st.state === 'bloque' || st.state === 'attente' || st.state === 'manoeuvre') && st.blockedFor > 1.5 && Math.floor(st.blockedFor * 2) % 6 === 0) {
+          const o = a.obsId ? ctx.vehicles.get(a.obsId) : undefined;
+          const os = o ? ap.status(o) : undefined;
+          console.log(`   BLK t=${ctx.clock.now.toFixed(1)} ${v.kind}#${v.id} @${v.x.toFixed(1)},${v.z.toFixed(1)} h=${v.heading.toFixed(2)} ${st.mode}/${st.state}/${st.reason} bf=${st.blockedFor.toFixed(1)} obs=${a.obsReason}#${a.obsId} prop=${a.obsPropId} d=${a.obsDist.toFixed(1)} ${o ? `${o.kind}/${o.faction} @${o.x.toFixed(1)},${o.z.toFixed(1)} sp=${o.speed.toFixed(1)} ${os.mode}/${os.state}/${os.reason} L=${os.leaderId} drv=${o.seats[0]}` : ''} ${a.obsPropId ? JSON.stringify((({kind,x,z,halfX,halfZ,hp,movable,heading}: any)=>({kind,x,z,halfX,halfZ,hp,movable,heading}))(ctx.props.get(a.obsPropId))) : ''} seg=${a.seg}/${a.n} s=${a.s.toFixed(0)}/${a.total.toFixed(0)} replans=${a.replans} avoid=${a.avoidVeh}/${a.avoidProp}`);
+        }
+      }
+    }
+    const dest = j.destination;
+    const conv = ctx.squads.list.map((q: any) => [q, cmd.convoyOf(q.id)]).filter((x: any) => x[1]);
+    const line = conv.map(([q, s]: any) => `${q.name}:${s.stage}`).join(' ');
+    const near = dest ? crewed.map((v) => { const s = ap.status(v); return `${v.kind}#${v.id}${v.id === mine!.id ? '*' : ''} d=${Math.hypot(v.x - dest.x, v.z - dest.z).toFixed(0)} ${s.mode}/${s.state}/${s.reason} rem=${s.remaining.toFixed(0)} bf=${s.blockedFor.toFixed(0)} sp=${v.speed.toFixed(1)} L=${s.leaderId}`; }).join(' | ') : '';
+    const minD = dest ? Math.min(...crewed.map((v) => Math.hypot(v.x - dest.x, v.z - dest.z))) : 1e9;
+    if (minD < 600 || line !== last) console.log(`t=${ctx.clock.now.toFixed(0)} j=${j.stage} ${line}\n   ${near}`);
+    last = line;
+  }
+  const dest = j.destination!;
+  console.log('dest', dest, 'me', me.x.toFixed(0), me.z.toFixed(0), Math.hypot(me.x - dest.x, me.z - dest.z).toFixed(0));
+  t.step(40);
+  console.log('after40 me', Math.hypot(me.x - dest.x, me.z - dest.z).toFixed(0), me.vehicleId);
+  for (const v of crewed) console.log(v.kind, v.id, v.x.toFixed(0), v.z.toFixed(0), Math.hypot(v.x - dest.x, v.z - dest.z).toFixed(0));
+}, 900000);
