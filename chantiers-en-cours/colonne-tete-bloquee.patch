+ */
+const PROMOTE = 30;
+
+function rank(p: { msg: RadioMessage; at: number }, now: number): number {
+  const base = p.msg.priority;
+  if (base === 0 || base >= 2) return base;
+  const r = base + (now - p.at) / PROMOTE;
+  return r > 2 ? 2 : r;
+}
