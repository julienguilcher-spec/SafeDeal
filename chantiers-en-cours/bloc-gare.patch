+import { it } from 'vitest';
+import { createTestContext } from '@/core/testing';
+import { createSystems as world } from '@/world/query';
+it('grid', async () => {
+  const t = createTestContext({ seed: 1, strict: false, modules: [world] });
+  const cx = Number(process.env['GX']), cz = Number(process.env['GZ']);
+  await t.start({ mode: 'libre', role: 'crs', place: 'x', x: cx, z: cz } as never);
+  const w = t.ctx.world;
+  const R = 24;
+  const lines: string[] = [];
+  for (let z = cz + R; z >= cz - R; z -= 2) {
+    let l = '';
+    for (let x = cx - R; x <= cx + R; x += 1) {
+      const s = w.surfaceAt(x, z);
+      const ch = s === 'road' ? 'r' : s === 'sidewalk' ? 's' : s === 'plaza' ? 'p' : s === 'building' ? '#' : s === 'park' ? 'g' : s[0]!;
+      l += w.isFree(x, z, 0.4) ? ch : 'X';
+    }
+    lines.push(`${String(z).padStart(5)} ${l}`);
+  }
+  console.log(`x from ${cx - R} to ${cx + R}\n` + lines.join('\n'));
+});
