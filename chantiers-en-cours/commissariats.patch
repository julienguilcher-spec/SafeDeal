@@ -0,0 +1,93 @@
+// Commissariats — contrôle des sites figés sur la vraie carte de Paris (exécuté seulement si public/data/paris est
+// présent). Régénérer les données : CRS_COMMISSARIATS_PRINT=1 npx vitest run tests/unit/commissariats.sites.paris.test.ts --silent=false
+import { beforeAll, describe, expect, it } from 'vitest';
+import type { RoadSample } from '@/core/contracts';
+import { COMMISSARIATS, COMMISSARIAT_SEEDS } from '@/world/commissariats';
+import {
+  CHECK_DESTINATIONS, SLOT_RULES, exitWidthRules, layoutYard, parkEligible, pathWidthOk, printFrozen, siteLoadRadius, validateSite,
+} from '@/world/commissariats/layout';
+import { createWorldQuery } from '@/world/query';
+import type { WorldQueryImpl } from '@/world/query';
+import { FsMapSource, defaultParisDir } from '@/world/query/source-fs';
+
+const env = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env ?? {};
+const available = await new FsMapSource(defaultParisDir()).exists();
+if (!available) console.log('[commissariats] carte de Paris absente : essai non exécuté');
+const PRINT = env.CRS_COMMISSARIATS_PRINT === '1';
+
+describe.skipIf(!available)('commissariats sur la vraie carte de Paris', () => {
+  let world: WorldQueryImpl;
+
+  beforeAll(async () => {
+    world = createWorldQuery({ source: 'paris', parisSource: new FsMapSource(defaultParisDir()) });
+    await world.boot();
+  }, 120_000);
+
+  it.runIf(PRINT)('calcule et imprime les dispositions (CRS_COMMISSARIATS_PRINT=1)', async () => {
+    const out: string[] = [];
+    for (const seed of COMMISSARIAT_SEEDS) {
+      await world.whenLoaded(seed.x, seed.z, 450);
+      try {
+        const l = layoutYard(world, seed);
+        const report = validateSite(world, l.def);
+        out.push(printFrozen(seed.id, l.frozen));
+        console.log(`[${seed.id}] ${l.notes.join(' ; ') || 'rue du commissariat'} — ouverture ${report.openArcDeg}° — ${report.ok ? 'valide' : 'PROBLÈMES :\n  ' + report.problems.join('\n  ')}`);
+      } catch (e) {
+        console.log(`[${seed.id}] ÉCHEC : ${(e as Error).message}`);
+      }
+    }
+    console.log('export const FROZEN_LAYOUTS: Readonly<Record<string, FrozenLayout>> = {\n' + out.join('\n') + '\n};');
+  }, 600_000);
+
+  it('les sept sites sont figés', () => {
+    expect(COMMISSARIATS.map((c) => c.id)).toEqual(COMMISSARIAT_SEEDS.map((s) => s.id));
+  });
+
+  it('validateSite accepte chaque site (porte, places, dégagements, itinéraires, cheminements)', async () => {
+    const bad: string[] = [];
+    for (const def of COMMISSARIATS) {
+      await world.whenLoaded(def.door.x, def.door.z, siteLoadRadius(def));
+      const r = validateSite(world, def);
+      if (!r.ok) bad.push(`${def.id} :\n  ${r.problems.join('\n  ')}`);
+      expect(r.openArcDeg).toBeGreaterThanOrEqual(SLOT_RULES.openArcDeg);
+      expect(r.slots).toHaveLength(def.slots.length);
+    }
+    if (bad.length > 0) console.log(bad.join('\n'));
+    expect(bad).toEqual([]);
+  }, 600_000);
+
+  it('les itinéraires de chaque tête de file vers Concorde et République gardent la largeur voulue', async () => {
+    const path: number[] = [];
+    for (const def of COMMISSARIATS) {
+      await world.whenLoaded(def.door.x, def.door.z, siteLoadRadius(def));
+      for (const t of def.stock) {
+        const head = def.slots[t.slots[0]!]!;
+        const engine = t.vehicle === 'canon_eau' || t.vehicle === 'centaure' || t.vehicle === 'car_crs';
+        for (const dst of CHECK_DESTINATIONS) {
+          const found = world.findPath(head.x, head.z, dst.x, dst.z, 'vehicle', path, {
+            heading: head.heading, uturn: 200, contraflow: 3, minWidth: (engine ? 2.6 : 2.05) + 1.2,
+          });
+          expect(found, `${t.callsign} → ${dst.name}`).toBe(true);
+          for (const r of exitWidthRules(engine)) {
+            const w = pathWidthOk(world, path, r.min, r.minOneway, r.upTo);
+            expect(w.ok, `${t.callsign} → ${dst.name} : ${w.worst} m < ${r.min} m`).toBe(true);
+          }
+        }
+      }
+    }
+  }, 600_000);
+
+  it('chaque rue de places admet le stationnement selon la règle de la circulation', async () => {
+    const s: RoadSample = { edgeId: -1, x: 0, z: 0, heading: 0, dist: 0, width: 0, name: '', roadClass: 'residential', oneway: false };
+    for (const def of COMMISSARIATS) {
+      await world.whenLoaded(def.door.x, def.door.z, siteLoadRadius(def));
+      for (const slot of def.slots) {
+        expect(world.nearestRoad(slot.x, slot.z, s, 12)).toBe(true);
+        const e = world.edge(s.edgeId);
+        expect(parkEligible(e), `${def.id} : ${e.name} ${e.width} m`).toBe(true);
+        expect(e.width).toBeGreaterThanOrEqual(e.oneway ? SLOT_RULES.parkMinOneway : SLOT_RULES.parkMinTwoway);
+        expect((def.bayStreet ?? def.street).split(' et '), `${def.id} : ${e.name}`).toContain(e.name || 'rue sans nom');
+      }
+    }
+  }, 600_000);
+});
diff --git a/crs-simulation/tests/unit/patrols.deploy.test.ts b/crs-simulation/tests/unit/patrols.deploy.test.ts
new file mode 100644
index 0000000..68076d6
--- /dev/null
+++ b/crs-simulation/tests/unit/patrols.deploy.test.ts
@@ -0,0 +1,169 @@
+// Patrouilles engagées depuis un commissariat : deploy() pose la voiture à sa place réservée (rue Chauchat → places du
+// 9e), équipage de trois à bord, « Au poste » — aussi en mission, où aucune patrouille n'est mise en place d'office ;
+// elle reste immobile et silencieuse jusqu'au premier ordre ; send() la fait partir en urgence ; sendHome() la ramène
+// sans deux tons à sa place, où elle repasse « Au poste ». La mise en place ordinaire des patrouilles est inchangée.
+import { describe, expect, it } from 'vitest';
+
+import type { SessionConfig } from '@/core/contracts';
+import { createTestContext } from '@/core/testing';
+import { createSystems as world } from '@/world/query';
+import { createSystems as roles } from '@/sim/roles';
+import { createSystems as people } from '@/sim/people';
+import { createSystems as vehicles } from '@/sim/vehicles';
+import { createSystems as police } from '@/sim/police';
+import { createSystems as radio } from '@/gameplay/radio';
+import { createSystems as session } from '@/gameplay/session';
+import { createSystems as patrols, PATROLS_SERVICE, PatrolsSystem } from '@/gameplay/patrols';
+import type { PatrolPose, PatrolsApi } from '@/gameplay/patrols';
+import { commissariatById } from '@/world/commissariats';
+
+const SIM = [world, roles, people, vehicles, police, radio, session, patrols];
+const MEANS = { sections: 1, fourgons: 1, centaure: 0, canon_eau: 0, bravm: 0, drone: 0, pompiers: 0, samu: 0, secours_sur_appel: true };
+const REPUBLIQUE = { x: 3123, z: -208 };
+
+/** Place de tête d'une unité du stock d'un commissariat. */
+function slotOf(siteId: string, entryId: string): { pose: PatrolPose; door: { x: number; z: number } } {
+  const def = commissariatById(siteId)!;
+  const tpl = def.stock.find((s) => s.id === entryId)!;
+  const s = def.slots[tpl.slots[0]!]!;
+  return { pose: { x: s.x, z: s.z, heading: s.heading }, door: def.door };
+}
+
+async function start(config: Partial<SessionConfig>, seed = 7) {
+  const t = createTestContext({ seed, strict: false, modules: SIM });
+  await t.start({
+    mode: 'libre', role: 'commandant', rank: 'commandant', place: 'Place de la Concorde', x: -10, z: 15, crowdSize: 0,
+    tension: 0.2, volatility: 0.2, duration: 'standard', ...config,
+    extra: { moyens: MEANS, variante: 'salle', foyers: 0, ...(config.extra ?? {}) },
+  } as Partial<SessionConfig>);
+  t.step(1);
+  return { t, ctx: t.ctx, api: t.ctx.require<PatrolsApi>(PATROLS_SERVICE) };
+}
+
+function angle(a: number, b: number): number {
+  return Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));
+}
+
+describe('patrouilles engagées depuis un commissariat', () => {
+  it('deploy en mission : au poste, trois à bord, immobile 15 min ; send() en urgence ; sendHome() sans deux tons jusqu’à sa place', async () => {
+    const config: Partial<SessionConfig> = { mode: 'carriere', missionId: 'crs-01-premier-samedi' };
+    expect(PatrolsSystem.count({ role: 'commandant', missionId: 'crs-01-premier-samedi' })).toBe(0);
+    const { t, ctx, api } = await start(config);
+    expect(api.list.length).toBe(0);
+    const { pose, door } = slotOf('9e', '9e:tv19');
+    const id = api.deploy('tv', 'TV 75-19', 'commissariat du 9e', pose, door);
+    expect(id).toBeGreaterThan(0);
+    expect(api.isPatrol(id)).toBe(true);
+    const view = api.statusOf(id)!;
+    expect(view.state).toBe('au_poste');
+    expect(view.label).toBe('Au poste');
+    expect(view.home).toBe('commissariat du 9e');
+    const v = ctx.vehicles.get(view.vehicleId)!;
+    expect(v.kind).toBe('voiture_police');
+    expect(v.faction).toBe('police');
+    expect(Math.hypot(v.x - pose.x, v.z - pose.z)).toBeLessThan(0.05);
+    expect(angle(v.heading, pose.heading)).toBeLessThan(0.01);
+    const squad = ctx.squads.get(id)!;
+    expect(squad.name).toBe('TV 75-19');
+    expect(squad.members.length).toBe(3);
+    for (const m of squad.members) expect(ctx.people.get(m)!.vehicleId).toBe(v.id);
+    expect(v.seats[0]).not.toBe(0);
+
+    // au poste : immobile et silencieuse pendant un quart d'heure
+    const t0 = ctx.clock.now;
+    let drift = 0;
+    for (let k = 0; k < 30; k++) {
+      t.step(30);
+      drift = Math.max(drift, Math.hypot(v.x - pose.x, v.z - pose.z));
+    }
+    expect(drift).toBeLessThan(0.5);
+    expect(view.state).toBe('au_poste');
+    expect(ctx.radio.log.filter((m) => m.from === 'TV 75-19' && m.t > t0)).toEqual([]);
+
+    // engagée : en urgence vers la place de la République
+    expect(api.send(id, REPUBLIQUE.x, REPUBLIQUE.z)).toBe(true);
+    t.step(2);
+    expect(view.state).toBe('en_route');
+    let sirens = 0, samples = 0;
+    for (let k = 0; k < 200 && view.state === 'en_route'; k++) {
+      t.step(2);
+      if (Math.abs(v.speed) > 2) {
+        samples++;
+        if (v.siren !== 0) sirens++;
+      }
+    }
+    console.log(`aller : ${view.state}, à ${Math.round(Math.hypot(v.x - REPUBLIQUE.x, v.z - REPUBLIQUE.z))} m de République, sirène ${sirens}/${samples}`);
+    expect(samples).toBeGreaterThan(10);
+    expect(sirens / samples).toBeGreaterThan(0.8);
+    expect(Math.hypot(v.x - pose.x, v.z - pose.z)).toBeGreaterThan(500);
+
+    // retour au commissariat, sans deux tons
+    const t1 = ctx.clock.now;
+    expect(api.sendHome(id, pose)).toBe(true);
+    expect(view.state).toBe('en_route');
+    expect(view.label).toBe('Retour au poste');
+    let loud = 0, moving = 0;
+    for (let k = 0; k < 450 && view.state !== 'au_poste'; k++) {
+      t.step(2);
+      if (Math.abs(v.speed) > 1) {
+        moving++;
+        if (v.siren !== 0 || v.beacons) loud++;
+      }
+    }
+    t.step(20);
+    const d = Math.hypot(v.x - pose.x, v.z - pose.z);
+    const said = ctx.radio.log.filter((m) => m.from === 'TV 75-19' && m.t >= t1).map((m) => m.text);
+    console.log(`retour : ${view.state} en ${Math.round(ctx.clock.now - t1)} s, à ${d.toFixed(1)} m de sa place, cap ${(angle(v.heading, pose.heading) * 180 / Math.PI).toFixed(0)}° | ${said.join(' / ')}`);
+    expect(view.state).toBe('au_poste');
+    expect(view.label).toBe('Au poste');
+    expect(moving).toBeGreaterThan(10);
+    expect(loud).toBe(0);
+    expect(d).toBeLessThan(15);
+    expect(said.length).toBeGreaterThanOrEqual(2);
+    expect(said.some((m) => m.includes('Retour commissariat du 9e, sans urgence'))).toBe(true);
+    expect(said.some((m) => m.includes('Au poste, commissariat du 9e'))).toBe(true);
+    for (const m of squad.members) expect(ctx.people.get(m)!.vehicleId).toBe(v.id);
+  }, 900000);
+
+  it('deploy BAC : trois policiers en civil, voiture banalisée quand elle est définie, sinon voiture de police', async () => {
+    const { ctx, api } = await start({ extra: { patrouilles: 0 } } as Partial<SessionConfig>);
+    const { pose, door } = slotOf('9e', '9e:bac09');
+    const id = api.deploy('bac', 'BAC 75-09', 'commissariat du 9e', pose, door);
+    const view = api.statusOf(id)!;
+    const v = ctx.vehicles.get(view.vehicleId)!;
+    expect(view.kind).toBe('bac');
+    expect(view.state).toBe('au_poste');
+    expect(v.kind).toBe(ctx.vehicles.def('voiture_bac') ? 'voiture_bac' : 'voiture_police');
+    const squad = ctx.squads.get(id)!;
+    expect(squad.members.length).toBe(3);
+    for (const m of squad.members) {
+      const p = ctx.people.get(m)!;
+      expect(p.kind).toBe('policier_civil');
+      expect(p.vehicleId).toBe(v.id);
+    }
+  }, 300000);
+
+  it('mise en place ordinaire inchangée et identique à graine égale', async () => {
+    const snapshot = async () => {
+      const { ctx, api } = await start({ extra: { patrouilles: 5 } } as Partial<SessionConfig>, 13);
+      return api.list.map((p) => {
+        const v = ctx.vehicles.get(p.vehicleId)!;
+        const crew = ctx.squads.get(p.squadId)!.members.map((m) => {
+          const q = ctx.people.get(m)!;
+          return `${q.kind}/${q.poste}/${q.rank}`;
+        });
+        return { name: p.name, kind: p.kind, home: p.home, state: p.state, vehicle: v.kind, x: v.x, z: v.z, heading: v.heading, crew };
+      });
+    };
+    const a = await snapshot();
+    const b = await snapshot();
+    expect(a.length).toBe(5);
+    expect(b).toEqual(a);
+    for (const p of a) {
+      expect(p.state).toBe('patrouille');
+      // (voiture banalisée pour la BAC seulement quand le module des véhicules la définit)
+      expect(['voiture_police', 'voiture_bac']).toContain(p.vehicle);
+      if (p.kind === 'tv') expect(p.vehicle).toBe('voiture_police');
+    }
+  }, 300000);
+});
diff --git a/crs-simulation/tests/unit/police-command.convoi-sans-urgence.test.ts b/crs-simulation/tests/unit/police-command.convoi-sans-urgence.test.ts
new file mode 100644
index 0000000..e76ec96
--- /dev/null
+++ b/crs-simulation/tests/unit/police-command.convoi-sans-urgence.test.ts
@@ -0,0 +1,91 @@
+// Commandement — convoi sans urgence (retour au commissariat) : la colonne roule sans deux tons ni gyrophares, et une
+// voiture civile arrêtée devant elle n'est pas retirée de la chaussée (la colonne attend ou la contourne, comme tout
+// le monde). Par défaut (urgence), deux tons pendant le trajet : comportement inchangé. Quartier d'essai, modules réels.
+import { describe, expect, it } from 'vitest';
+import type { Vehicle } from '@/core/contracts';
+import { createSystems as world } from '@/world/query';
+import { createSystems as people } from '@/sim/people';
+import { createSystems as items } from '@/sim/items';
+import { createSystems as hazards } from '@/sim/hazards';
+import { createSystems as law } from '@/gameplay/law';
+import { createSystems as props } from '@/sim/props';
+import { createSystems as vehicles } from '@/sim/vehicles';
+import type { ConvoyEvent } from '@/sim/police/command/api';
+import { startCommand } from '@/sim/police/command/testkit';
+
+const MODULES = [world, people, items, hazards, law, props, vehicles];
+const WEST = -Math.PI / 2;
+
+interface Run {
+  stages: string[];
+  /** Relevés pendant l'étape 'route' : véhicules de la colonne en mouvement, dont sirène en marche. */
+  moving: number;
+  siren: number;
+  beacons: number;
+  /** La voiture civile arrêtée sur l'itinéraire existe-t-elle encore ? */
+  civilKept: boolean;
+  civilBlocked: number;
+  final: string;
+}
+
+async function run(urgence: boolean | undefined): Promise<Run> {
+  const t = await startCommand(MODULES, { mode: 'test', x: 150, z: 289.5 }, { seed: 21, dt: 1 / 30 });
+  const { ctx } = t;
+  t.api.tuning.autoAssume = false;
+  // une section embarquée (trois fourgons) à 250 m du point de stationnement, gyrophares et sirène allumés d'une
+  // intervention précédente
+  const sec = t.units.createSection({ x: 400, z: 289.5, heading: WEST, section: 1, vehicles: true, drivers: true, layout: 'embarque' });
+  for (const v of sec.vehicles) {
+    v.siren = 1;
+    v.beacons = true;
+  }
+  // une voiture civile arrêtée dans la voie, sur l'itinéraire, à 90 m devant la colonne
+  const civil = ctx.vehicles.spawn('utilitaire', 300, 289.5, WEST, { faction: 'civil' });
+  civil.cmd.brake = 1;
+  civil.cmd.handbrake = true;
+  const stages: string[] = [];
+  ctx.events.onAny('command:convoy', (d) => {
+    const e = d as ConvoyEvent;
+    if (e.squadId === sec.squad.id) stages.push(e.stage);
+  });
+  t.step(1);
+  const dest = { x: 150, z: 289.5, heading: WEST, layout: 'file' as const, boardFirst: true, stagger: true, disembark: false, ...(urgence === undefined ? {} : { urgence }) };
+  expect(t.api.arrive(sec.squad.id, dest)).toBe(true);
+  let moving = 0, siren = 0, beacons = 0, civilBlocked = 0;
+  t.run(420, 0.5, () => {
+    const st = t.api.convoyOf(sec.squad.id)!;
+    if (st.stage === 'route') {
+      for (const v of sec.vehicles as Vehicle[]) {
+        if (Math.abs(v.speed) < 1) continue;
+        moving++;
+        if (v.siren !== 0) siren++;
+        if (v.beacons) beacons++;
+      }
+      if (ctx.vehicles.get(civil.id)) civilBlocked++;
+    }
+    return st.stage === 'en_place' || st.stage === 'echec';
+  });
+  const st = t.api.convoyOf(sec.squad.id)!;
+  const out: Run = { stages, moving, siren, beacons, civilKept: ctx.vehicles.get(civil.id) !== undefined, civilBlocked, final: st.stage };
+  const lead = sec.vehicles.reduce((a, b) => (a.x < b.x ? a : b));
+  console.log(`urgence ${String(urgence)} : étapes ${stages.join(' ')} | relevés en mouvement ${moving}, sirène ${siren}, gyrophares ${beacons} | voiture civile ${out.civilKept ? 'toujours là' : 'retirée'} | tête à x ${lead.x.toFixed(0)}`);
+  return out;
+}
+
+describe('convoi sans urgence', () => {
+  it('urgence false : ni sirène ni gyrophares en route, la voiture civile arrêtée n’est pas retirée, la colonne arrive', async () => {
+    const r = await run(false);
+    expect(r.moving).toBeGreaterThan(20);
+    expect(r.siren).toBe(0);
+    expect(r.beacons).toBe(0);
+    expect(r.civilKept).toBe(true);
+    expect(r.final).toBe('en_place');
+  }, 600000);
+
+  it('par défaut : deux tons pendant le trajet (comportement inchangé)', async () => {
+    const r = await run(undefined);
+    expect(r.moving).toBeGreaterThan(20);
+    expect(r.siren / r.moving).toBeGreaterThan(0.8);
+    expect(r.final).toBe('en_place');
+  }, 600000);
+});
