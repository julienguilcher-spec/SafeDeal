+  refused: string | null;
+  blocked: string | null;
+  blockedAt: number;
+  /** Échantillons de la surveillance : instant, distance au point, itinéraire restant de la colonne (−1 : aucune). */
+  watch: { t: number; d: number; r: number }[];
+  watchUsed: boolean;
