+/** Point du sol à `d` m du joueur dans la direction `a` (rad). */
+function ground(g: Game, a: number, d: number): Designation {
+  return designationAt(g.core, g.me.x + Math.sin(a) * d, g.me.z + Math.cos(a) * d);
+}
