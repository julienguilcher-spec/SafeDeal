+/* =====================================================================================
+ * Ordres directs — L'ORDRE PRÊT : ce que fait Entrée sur ce que le joueur regarde (logique pure, déterministe).
+ *
+ *   naturalOrder(env, désignation, à-qui)   la première règle qui s'applique (§1.3) :
+ *     a  il tient un interpellé : Remettre (fourgon à 12 m), Confier (binôme libre à 60 m), Emmenez-le (fourgon à
+ *        100 m), Faire venir le fourgon (plus loin) ;
+ *     b  l'unité choisie (U) est un fourgon cellulaire : partir au commissariat / venir ici ;
+ *     c  un auteur de fait constaté désigné à moins de 120 m : Interpeller ;
+ *     d  un blessé au sol ou un feu à moins de 10 m du point : Secours ici ;
+ *     e  le réticule même sur un policier d'une unité sous ses ordres qui n'est pas avec lui (≤ 60 m) : avec moi ;
+ *     f  au moins 8 manifestants à 15 m du point (≤ 120 m) : Bloquer ici, face à la foule ;
+ *     g  une rue sous le point (≤ 150 m) : Bloquer la rue ;
+ *     h  un autre point du sol à 6 m au moins (≤ 400 m) : Envoyer ;
+ *     i  rien : ligne grise, aucun ordre (Entrée sur le ciel ne rappelle jamais les barrages).
+ *   Disperser, Charger, le gaz ne sont jamais l'ordre prêt : sur une foule, la ligne « autre » (Maj+Entrée) propose
+ *   Disperser (les sommations d'abord si elles manquent) ; sur une rue, « Envoyer : rue … » sans la barrer.
+ *   holdNatural(affiché, nouveau, t)        la ligne change au plus toutes les 0,5 s ; Entrée donne la ligne affichée.
+ * ===================================================================================== */
+
+import type { OrderType } from '@/core/contracts';
+import type { IntentId } from '../cardTypes';
+import { CAP_REFUSALS, REFUS, accepts, capRefusal } from './caps';
+import type { Addressee, Designation, DirectEnv, DirectUnit, DirectVerb, WhoKey } from './types';
+import { addressableUnitOf, resolveWho, unitOfKey, whoLabel, whyNobody } from './who';
+import { NOTHING_LINE, VERB_WORDS, distText, pillWhoText, placeBare, placeWithArticle, vanWords } from './words';
+
+/** Portées (m) des règles du §1.3. */
+export const RANGE = {
+  /** remettre au fourgon cellulaire */
+  vanHandover: 12,
+  /** confier à un binôme libre */
+  pair: 60,
+  /** l'emmener à pied au fourgon (au-delà : le faire venir) */
+  vanWalk: 100,
+  /** interpeller un auteur désigné */
+  arrest: 120,
+  /** blessé ou feu autour du point */
+  rescue: 10,
+  /** rappeler une unité visée au réticule */
+  recall: 60,
+  /** foule autour du point (rayon) et nombre minimal de manifestants */
+  crowdRadius: 15,
+  crowdMin: 8,
+  crowdOrder: 120,
+  /** rue sous le point (recherche) et portée du barrage */
+  road: 25,
+  block: 150,
+  /** point le plus proche, le plus loin pour Envoyer */
+  minPoint: 6,
+  send: 400,
+  /** « Y aller » en formation à moins de 60 m d'une foule (intents.ts NEAR_CROWD) */
+  nearCrowd: 60,
+} as const;
+
+/** Changement de ligne au plus toutes les HOLD s ; une ligne changée depuis moins de FLASH s clignote. */
+export const HOLD = 0.5;
+export const FLASH = 0.3;
+
+export type NaturalRule = 'a' | 'b' | 'c' | 'd' | 'e' | 'f' | 'g' | 'h' | 'i';
+
+/** L'ordre prêt (ou la ligne « autre ») tel qu'il est affiché et donné. */
+export interface NaturalOrder {
+  rule: NaturalRule;
+  verb: DirectVerb;
+  /** Un appui donne un ordre (faux : ligne grise, `lock` dit pourquoi). */
+  enabled: boolean;
+  /** Ligne sans la touche (« Bloquer la rue Saint-Gilles · MISTRAL 1 · 90 m »). */
+  text: string;
+  /** Ligne 1 de la pastille (« Bloquer la rue ») et ligne 2 (« MISTRAL 1 · 90 m »). */
+  short: string;
+  whoShort: string;
+  /** Unité qui reçoit l'ordre (null : le joueur agit lui-même, ou personne). */
+  who: Addressee | null;
+  /** Point de l'ordre, cap de la ligne (face à la foule), distance au joueur. */
+  x: number;
+  z: number;
+  heading: number;
+  distance: number;
+  /** Lieu nommé, sans article (« rue Saint-Gilles », « carrefour Voltaire »), '' sinon. */
+  place: string;
+  /** Ordre de la simulation (null : action du joueur, appel de secours). */
+  orderType: OrderType | null;
+  /** Intention de la carte dont la ligne de fiche est prise (envoi par buildCard → sendCardLine), null sinon. */
+  intent: IntentId | null;
+  targetId: number;
+  /** Personne désignée (interpellé, auteur, policier), 0 sinon. */
+  personId: number;
+  /** Phrase de refus ou d'explication (ligne grise, ou les sommations que le premier appui fait faire). */
+  lock: string | null;
+  /** Le premier appui lance la chaîne légale (sommations) au lieu de l'ordre. */
+  legalFirst: boolean;
+  /** Ligne « autre » (Maj+Entrée), null s'il n'y en a pas. */
+  autre: NaturalOrder | null;
+  /** Clé de stabilité : même clé = même ordre (la ligne ne « clignote » pas pour une distance qui bouge). */
+  key: string;
+}
+
+/** « fourgon cellulaire 1 » d'après l'indicatif « CELLULAIRE 1 ». */
+export const vanLabel = vanWords;
+
+function blank(rule: NaturalRule, verb: DirectVerb, x: number, z: number, distance: number): NaturalOrder {
+  return {
+    rule, verb, enabled: true, text: '', short: VERB_WORDS[verb].short, whoShort: '', who: null, x, z, heading: 0, distance, place: '',
+    orderType: null, intent: null, targetId: 0, personId: 0, lock: null, legalFirst: false, autre: null, key: '',
+  };
+}
+
+function finish(o: NaturalOrder): NaturalOrder {
+  o.key = [o.rule, o.verb, o.who ? o.who.squadIds.join('+') : '-', o.place, o.personId, o.enabled ? 1 : 0].join('|');
+  return o;
+}
+
+/** Ligne d'ordre « VERBE · QUI (quitte …) · DISTANCE ». */
+function withWho(verbPhrase: string, who: Addressee | null, distance: number | null): string {
+  const parts = [verbPhrase];
+  if (who) parts.push(who.leaves !== '' ? `${who.label} (${who.leaves})` : who.label);
+  if (distance !== null) parts.push(distText(distance));
+  return parts.join(' · ');
+}
+
+/** Refus propre à l'unité choisie (capacités, BRAV-M sur un barrage alors qu'une section existe). */
+function refusalFor(env: DirectEnv, who: Addressee, verb: DirectVerb): string | null {
+  if (who.squadIds.length !== 1) return null;
+  const u = env.units.find((q) => q.squadId === who.squadIds[0]);
+  if (!u) return null;
+  const cap = capRefusal(u.kind, verb);
+  if (cap) return cap;
+  if (u.kind === 'bravm' && (verb === 'bloquer' || verb === 'face_foule') && who.manual
+    && env.units.some((q) => q.kind === 'troupe' && q.squadId !== env.ownSquadId && q.symbol !== 'compagnie' && q.valid > 0)) {
+    return CAP_REFUSALS.bravmBloquer;
+  }
+  return null;
+}
+
+/** Remplit QUI et la ligne ; sans unité ou avec un refus, la ligne devient grise avec la phrase. */
+function addressed(env: DirectEnv, o: NaturalOrder, whoKey: WhoKey, verbPhrase: string, showDistance: boolean): NaturalOrder {
+  const who = resolveWho(env, whoKey, o.verb, o.x, o.z);
+  o.who = who;
+  if (!who) {
+    o.enabled = false;
+    o.lock = whyNobody(o.verb, env);
+    o.text = verbPhrase;
+    o.whoShort = '';
+    return finish(o);
+  }
+  const refusal = refusalFor(env, who, o.verb);
+  if (refusal) {
+    o.enabled = false;
+    o.lock = refusal;
+  }
+  o.text = withWho(verbPhrase, who, showDistance ? o.distance : null);
+  o.whoShort = pillWhoText(who.label, showDistance ? o.distance : null);
+  return finish(o);
+}
+
+function demonstrators(env: DirectEnv, x: number, z: number, r: number): { count: number; x: number; z: number } {
+  return env.demonstratorsAt(x, z, r);
+}
+
+/** Disperser possible sans sommations : seulement après la 3e, ou en riposte. */
+function dispersalLock(env: DirectEnv, x: number, z: number): boolean {
+  return env.sommations < 3 && !env.riposteAt(x, z);
+}
+
+/** Ligne « autre » Disperser (Maj+Entrée) sur une foule. */
+function disperserOther(env: DirectEnv, base: NaturalOrder, whoKey: WhoKey): NaturalOrder {
+  const o = blank(base.rule, 'disperser', base.x, base.z, base.distance);
+  o.orderType = 'refoulement';
+  o.intent = 'disperser';
+  o.heading = base.heading;
+  o.place = base.place;
+  const who = resolveWho(env, whoKey, 'disperser', o.x, o.z);
+  o.who = who;
+  if (!who) {
+    o.enabled = false;
+    o.lock = whyNobody('disperser', env);
+    o.text = 'Disperser la foule';
+    return finish(o);
+  }
+  const refusal = refusalFor(env, who, 'disperser');
+  if (refusal) {
+    o.enabled = false;
+    o.lock = refusal;
+    o.text = withWho('Disperser la foule', who, null);
+  } else if (dispersalLock(env, o.x, o.z)) {
+    // le premier appui fait faire les sommations (chaîne légale) ; la ligne le dit
+    o.legalFirst = true;
+    o.lock = REFUS.disperserSommations(who.label);
+    o.text = 'Disperser\u00a0: sommations d’abord';
+  } else {
+    o.text = withWho('Disperser la foule', who, null);
+  }
+  o.whoShort = pillWhoText(who.label, null);
+  return finish(o);
+}
+
+/** « Y aller » : en formation près d'une foule, en file sinon (même règle que la fiche, intents.ts goLine). */
+function goType(env: DirectEnv, x: number, z: number): OrderType {
+  return demonstrators(env, x, z, RANGE.nearCrowd).count >= RANGE.crowdMin ? 'avancer' : 'colonne';
+}
+
+/** Ligne « autre » Envoyer sur une rue (y aller sans la barrer). */
+function sendOther(env: DirectEnv, base: NaturalOrder, whoKey: WhoKey): NaturalOrder {
+  const o = blank(base.rule, 'envoyer', base.x, base.z, base.distance);
+  o.orderType = goType(env, o.x, o.z);
+  o.intent = 'envoyer';
+  o.place = base.place;
+  const done = addressed(env, o, whoKey, `Envoyer\u00a0: ${o.place}`, false);
+  done.text = `Envoyer\u00a0: ${o.place}`;
+  return done;
+}
+
+// ───────────────────────────── règles ─────────────────────────────
+
+/** Fourgons cellulaires sous ses ordres, le plus proche du joueur d'abord (places libres d'abord à distance égale). */
+function vansByDistance(env: DirectEnv): { u: DirectUnit; d: number; free: boolean }[] {
+  const p = env.player;
+  if (!p) return [];
+  return env.units.filter((u) => u.kind === 'cellulaire').map((u) => ({
+    u, d: Math.hypot(u.x - p.x, u.z - p.z), free: (u.seats ?? 0) - (u.detainees ?? 0) > 0,
+  })).sort((a, b) => a.d - b.d || a.u.squadId - b.u.squadId);
+}
+
+/** Règle a : le joueur tient un interpellé. null : aucune issue (pas de fourgon, pas de binôme). */
+function detaineeRule(env: DirectEnv): NaturalOrder | null {
+  const p = env.player;
+  if (!env.detainee || !p) return null;
+  const vans = vansByDistance(env).filter((v) => v.free);
+  const near = vans[0];
+  if (near && near.d <= RANGE.vanHandover && env.can.remettre) {
+    const o = blank('a', 'remettre', near.u.x, near.u.z, near.d);
+    o.personId = env.detainee.personId;
+    o.text = `Remettre l’interpellé au ${vanLabel(near.u.name)}`;
+    o.whoShort = vanLabel(near.u.name);
+    return finish(o);
+  }
+  const pair = env.freePair;
+  if (pair && pair.distance <= RANGE.pair && env.can.confier) {
+    const o = blank('a', 'confier', p.x, p.z, pair.distance);
+    o.personId = env.detainee.personId;
+    o.who = { squadIds: [pair.squadId], label: pair.name, distance: pair.distance, leaves: '', manual: false };
+    o.text = `Confier l’interpellé à ${pair.name}`;
+    o.whoShort = pillWhoText(pair.name, pair.distance);
+    return finish(o);
+  }
+  if (near && near.d <= RANGE.vanWalk) {
+    // aucun binôme libre : l'emmener à pied, le fourgon est marqué et sa distance dite
+    const o = blank('a', 'emmener', near.u.x, near.u.z, near.d);
+    o.personId = env.detainee.personId;
+    o.text = `Emmenez-le au ${vanLabel(near.u.name)} · ${distText(near.d)}`;
+    o.whoShort = pillWhoText(vanLabel(near.u.name), near.d);
+    return finish(o);
+  }
+  if (near && env.can.faireVenir) {
+    const o = blank('a', 'faire_venir', p.x, p.z, near.d);
+    o.personId = env.detainee.personId;
+    o.orderType = 'colonne';
+    o.who = { squadIds: [near.u.squadId], label: near.u.name, distance: near.d, leaves: '', manual: false };
+    o.text = `Faire venir le ${vanLabel(near.u.name)} ici · ${distText(near.d)}`;
+    o.whoShort = pillWhoText(vanLabel(near.u.name), near.d);
+    return finish(o);
+  }
+  return null;
+}
+
+/** Règle b : l'unité choisie est un fourgon cellulaire. */
+function vanRule(env: DirectEnv, whoKey: WhoKey): NaturalOrder | null {
+  const van = unitOfKey(env, whoKey);
+  const p = env.player;
+  if (!van || van.kind !== 'cellulaire' || !p) return null;
+  const n = van.detainees ?? 0;
+  const who: Addressee = { squadIds: [van.squadId], label: van.name, distance: Math.hypot(van.x - p.x, van.z - p.z), leaves: '', manual: true };
+  if (n > 0 && env.can.transfert) {
+    const o = blank('b', 'partir', van.x, van.z, who.distance);
+    o.who = who;
+    o.text = `${van.name}\u00a0: partir au commissariat (${n}/${van.seats ?? 0})`;
+    o.whoShort = pillWhoText(van.name, null);
+    return finish(o);
+  }
+  const o = blank('b', 'venir', p.x, p.z, who.distance);
+  o.who = who;
+  o.orderType = 'colonne';
+  o.text = `${van.name}\u00a0: venir ici`;
+  o.whoShort = pillWhoText(van.name, who.distance);
+  return finish(o);
+}
+
+/**
+ * L'ordre prêt pour cette désignation et ce choix « À qui » (§1.3). Déterministe : mêmes entrées, même ordre.
+ */
+export function naturalOrder(env: DirectEnv, des: Designation, whoKey: WhoKey = 'auto'): NaturalOrder {
+  const a = detaineeRule(env);
+  if (a) return a;
+  const b = vanRule(env, whoKey);
+  if (b) return b;
+
+  const x = des.x, z = des.z, d = des.distance;
+  const nothing = (): NaturalOrder => {
+    const o = blank('i', 'rien', x, z, d);
+    o.enabled = false;
+    o.text = NOTHING_LINE;
+    o.lock = REFUS.rien;
+    o.short = '';
+    return finish(o);
+  };
+  if (des.kind === 'none' || (d < RANGE.minPoint && des.kind !== 'person')) return nothing();
+
+  const person = des.person;
+  // c : un auteur de fait constaté
+  if (des.kind === 'person' && person && person.kind === 'offender' && d <= RANGE.arrest) {
+    const o = blank('c', 'interpeller', x, z, d);
+    o.orderType = 'interpeller';
+    o.intent = 'interpeller';
+    o.targetId = person.id;
+    o.personId = person.id;
+    return addressed(env, o, whoKey, `Interpeller ${person.label}`, true);
+  }
+  // d : un blessé au sol, un feu
+  const rescue = env.rescueAt(x, z, RANGE.rescue);
+  if (rescue) {
+    const o = blank('d', 'secours', x, z, d);
+    o.intent = 'secours';
+    o.orderType = 'secourir';
+    if (person && person.kind === 'wounded') o.personId = person.id;
+    const done = addressed(env, o, whoKey, `Secours ici\u00a0: ${rescue.label}`, false);
+    // l'appel des secours (pompiers, SAMU) part même sans unité à envoyer, pour tout policier (comme « Secours ici »)
+    if (!done.who) {
+      done.enabled = true;
+      done.lock = null;
+    }
+    done.text = `Secours ici\u00a0: ${rescue.label}`;
+    return finish(done);
+  }
+  // e : le réticule même sur un policier d'une unité sous ses ordres qui n'est pas avec lui
+  if (des.kind === 'person' && person && person.kind === 'police' && person.exact && d <= RANGE.recall && person.squadId !== 0) {
+    const u = addressableUnitOf(env, person.squadId);
+    if (u && !u.avecVous) {
+      const o = blank('e', 'avec_moi', x, z, d);
+      o.orderType = 'suivre';
+      o.personId = person.id;
+      o.who = { squadIds: [u.squadId], label: whoLabel(u), distance: d, leaves: '', manual: true };
+      o.text = `${whoLabel(u)}\u00a0: avec moi`;
+      o.whoShort = pillWhoText(whoLabel(u), null);
+      return finish(o);
+    }
+  }
+  // f : la foule
+  const crowd = demonstrators(env, x, z, RANGE.crowdRadius);
+  const isCrowd = crowd.count >= RANGE.crowdMin;
+  const road = env.roadAt(x, z, RANGE.road);
+  if (isCrowd && d <= RANGE.crowdOrder) {
+    const o = blank('f', 'face_foule', x, z, d);
+    o.orderType = 'ligne';
+    o.intent = 'bloquer';
+    o.place = road ? placeBare(road.name) : placeBare(des.place);
+    const p = env.player;
+    const dx = crowd.x - x, dz = crowd.z - z;
+    o.heading = Math.hypot(dx, dz) > 1 ? Math.atan2(dx, dz) : p ? Math.atan2(x - p.x, z - p.z) : 0;
+    const done = addressed(env, o, whoKey, 'Bloquer ici, face à la foule', true);
+    done.autre = disperserOther(env, done, whoKey);
+    return finish(done);
+  }
+  // g : une rue
+  if (road && d <= RANGE.block) {
+    const o = blank('g', 'bloquer', road.x, road.z, d);
+    o.orderType = 'couper_circulation';
+    o.intent = 'bloquer';
+    o.heading = road.heading;
+    o.place = placeBare(road.name);
+    const done = addressed(env, o, whoKey, `Bloquer ${placeWithArticle(road.name)}`, true);
+    done.autre = isCrowd ? disperserOther(env, done, whoKey) : sendOther(env, done, whoKey);
+    return finish(done);
+  }
+  // h : un point du sol
+  const o = blank('h', 'envoyer', x, z, d);
+  o.intent = 'envoyer';
+  o.orderType = goType(env, x, z);
+  const named = des.place !== '' ? des.place : env.roadAt(x, z, 40)?.name ?? env.placeName(x, z);
+  o.place = placeBare(named);
+  const phrase = o.place !== '' ? `Envoyer\u00a0: ${o.place}` : 'Envoyer ici';
+  if (d > RANGE.send) {
+    // trop loin pour viser : la carte s'ouvre sur ce point (même unité, même intention)
+    const done = addressed(env, o, whoKey, phrase, true);
+    done.enabled = false;
+    done.lock = REFUS.tropLoin;
+    return finish(done);
+  }
+  const done = addressed(env, o, whoKey, phrase, true);
+  if (isCrowd) done.autre = disperserOther(env, done, whoKey);
+  return finish(done);
+}
+
+// ───────────────────────────── stabilité de la ligne ─────────────────────────────
+
+/** Ligne affichée : l'ordre, depuis quand il est affiché (pour l'hystérésis et le clignotement). */
+export interface HeldNatural {
+  order: NaturalOrder;
+  since: number;
+}
+
+/**
+ * Ligne à afficher à l'instant `now` : un autre ordre (autre clé) ne remplace l'affiché qu'après HOLD s ; le même ordre
+ * met à jour ses chiffres (distance) sans attendre. Entrée donne `order` de la ligne retournée, jamais un ordre
+ * recalculé à l'appui.
+ */
+export function holdNatural(shown: HeldNatural | null, next: NaturalOrder, now: number): HeldNatural {
+  if (!shown) return { order: next, since: now };
+  if (shown.order.key === next.key) return { order: next, since: shown.since };
+  if (now - shown.since < HOLD) return shown;
+  return { order: next, since: now };
+}
+
+/** La ligne vient de changer (< FLASH s) : la montrer en surbrillance pour que le joueur voie ce qu'il ordonne. */
+export function isFlashing(shown: HeldNatural, now: number): boolean {
+  return now - shown.since < FLASH;
+}
+
+/** Le verbe peut-il être donné à cette unité (capacités) ? Pour griser un secteur de la roue. */
+export function verbAllowedFor(env: DirectEnv, who: Addressee | null, verb: DirectVerb): boolean {
+  if (!who) return false;
+  return who.squadIds.every((id) => {
+    const u = env.units.find((q) => q.squadId === id);
+    return !u || accepts(u.kind, verb);
+  });
+}
diff --git a/crs-simulation/src/ui/command/direct/state.ts b/crs-simulation/src/ui/command/direct/state.ts
new file mode 100644
index 0000000..e1346f1
--- /dev/null
+++ b/crs-simulation/src/ui/command/direct/state.ts
@@ -0,0 +1,136 @@
+/* =====================================================================================
+ * Ordres directs — LA LIGNE D'UNE UNITÉ (puce d'état, bloc d'ordres) : « QUI · QUOI · pour qui / où » (logique pure).
+ *
+ *   unitLine(instantané)        jamais « sans ordre » pour une unité sous ses ordres (§3.2) :
+ *     suit le joueur, il marche          « AVEC VOUS · vous suivent »
+ *     il s'est arrêté 3 s, foule ≤ 120 m « AVEC VOUS · en ligne face à la foule »
+ *     il s'est arrêté, pas de foule      « AVEC VOUS · en garde autour de vous »
+ *     « Avec moi » en véhicules          « AVEC VOUS · montent dans les fourgons (14/19) » / « … en colonne derrière vous »
+ *     autre ordre du joueur              le ticket, puis l'étiquette (« MISTRAL 2 · barre rue de Rivoli »)
+ *     « Laisser agir seuls »             « MISTRAL 2 · agissent seuls »
+ *     interpellation / secours finis     « BRAV-M · revient avec vous »
+ *     Envoyer fini                       « FAUCON 1 · au carrefour Voltaire · attend vos ordres »
+ *   groupSummary(unités, posture)  « AVEC VOUS · 3 sections + BRAV-M · en ligne face à la foule ».
+ *   NO_ORDER_TAG « SANS ORDRE » ne sert qu'aux unités que le joueur ne commande pas.
+ * ===================================================================================== */
+
+import type { Ticket } from './tickets';
+import { ticketText } from './tickets';
+import type { DirectVerb } from './types';
+import { VERB_WORDS, atPlace } from './words';
+
+export const AVEC_VOUS = 'AVEC VOUS';
+export const NO_ORDER_TAG = 'SANS ORDRE';
+/** Le joueur est « arrêté » après 3 s sur place ; une foule compte jusqu'à 120 m. */
+export const STOP_TIME = 3;
+export const CROWD_NEAR = 120;
+
+/** Posture de « Avec moi » quand le joueur est à pied (P2 la donne dans la simulation, sans ordre). */
+export type FollowPosture = 'suivent' | 'face_foule' | 'en_garde';
+
+/** Ce que la puce lit d'une unité à cet instant. */
+export interface UnitLineSnapshot {
+  name: string;
+  /** Sous les ordres du joueur. */
+  commanded: boolean;
+  /** Ordre du joueur en cours ou dernier (null : aucun) et son lieu sans article. */
+  playerVerb: DirectVerb | null;
+  place: string;
+  /** L'ordre du joueur est terminé (« ✓ » montré, puis l'étiquette). */
+  done: boolean;
+  /** Ticket vivant (reçu → en place, 6 s), null sinon. */
+  ticket: Ticket | null;
+  /** L'unité suit le joueur (« Avec moi »). */
+  followsPlayer: boolean;
+  /** « Avec moi » quand le joueur est en véhicule : montée (assis / total) ou colonne derrière lui. */
+  vehicles: { boarded: number; total: number; driving: boolean } | null;
+  /** Le joueur marche ; arrêté depuis (s) ; une foule à moins de 120 m. */
+  playerMoving: boolean;
+  playerStoppedFor: number;
+  crowdNear: boolean;
+  /** Retour vers le joueur après une interpellation ou un secours terminés. */
+  returning: boolean;
+  /** Étiquette de l'ordre de la simulation pour une unité que le joueur ne commande pas (« TIENT »), '' sinon. */
+  simTag: string;
+}
+
+/** Posture affichée d'une unité qui suit le joueur à pied. */
+export function followPosture(s: Pick<UnitLineSnapshot, 'playerMoving' | 'playerStoppedFor' | 'crowdNear'>): FollowPosture {
+  if (s.playerMoving || s.playerStoppedFor < STOP_TIME) return 'suivent';
+  return s.crowdNear ? 'face_foule' : 'en_garde';
+}
+
+const POSTURE_WORDS: Readonly<Record<FollowPosture, string>> = {
+  suivent: 'vous suivent', face_foule: 'en ligne face à la foule', en_garde: 'en garde autour de vous',
+};
+
+/** Ce que fait l'unité après un ordre du joueur terminé (« barre rue de Rivoli », « tient sa position »). */
+export function orderTag(verb: DirectVerb, place: string): string {
+  const w = VERB_WORDS[verb];
+  switch (verb) {
+    case 'bloquer':
+      return place !== '' ? `${w.doing} ${place}` : 'barre la rue';
+    case 'envoyer':
+    case 'venir':
+      return `${place !== '' ? atPlace(place) : 'sur le point'} · attend vos ordres`;
+    case 'face_foule':
+    case 'tenir':
+    case 'tortue':
+    case 'libre':
+    case 'cesser':
+      return w.doing;
+    default:
+      return place !== '' && w.doing !== '' ? `${w.doing} · ${place}` : w.doing;
+  }
+}
+
+/** La ligne d'une unité (§3.2). */
+export function unitLine(s: UnitLineSnapshot): string {
+  if (!s.commanded) return `${s.name} · ${s.simTag !== '' ? s.simTag : NO_ORDER_TAG}`;
+  if (s.ticket && s.ticket.state !== 'remplace') return ticketText(s.ticket);
+  if (s.returning) return `${s.name} · revient avec vous`;
+  if (s.followsPlayer || s.playerVerb === 'avec_moi') {
+    const v = s.vehicles;
+    if (v) return v.driving ? `${AVEC_VOUS} · en colonne derrière vous` : `${AVEC_VOUS} · montent dans les fourgons (${v.boarded}/${v.total})`;
+    return `${AVEC_VOUS} · ${POSTURE_WORDS[followPosture(s)]}`;
+  }
+  if (s.playerVerb === 'libre') return `${s.name} · agissent seuls`;
+  if (s.playerVerb !== null && s.playerVerb !== 'rien') return `${s.name} · ${orderTag(s.playerVerb, s.place)}`;
+  return `${s.name} · attend vos ordres`;
+}
+
+/** Unité comptée dans le résumé du groupe « avec vous ». */
+export interface SummaryUnit {
+  symbol: string;
+  avecVous: boolean;
+}
+
+const COUNT_WORDS: readonly { symbol: string; one: string; many: string }[] = [
+  { symbol: 'section', one: 'section', many: 'sections' },
+  { symbol: 'groupe', one: 'groupe', many: 'groupes' },
+  { symbol: 'binome', one: 'binôme', many: 'binômes' },
+  { symbol: 'bravm', one: 'BRAV-M', many: 'BRAV-M' },
+  { symbol: 'centaure', one: 'Centaure', many: 'Centaures' },
+  { symbol: 'canon_eau', one: 'canon à eau', many: 'canons à eau' },
+  { symbol: 'drone', one: 'drone', many: 'drones' },
+  { symbol: 'patrouille', one: 'patrouille', many: 'patrouilles' },
+];
+
+/** « 3 sections + BRAV-M » : les unités avec le joueur, par genre (la BRAV-M sans nombre). */
+export function countText(units: readonly SummaryUnit[]): string {
+  const parts: string[] = [];
+  for (const w of COUNT_WORDS) {
+    const n = units.filter((u) => u.avecVous && u.symbol === w.symbol).length;
+    if (n === 0) continue;
+    if (w.symbol === 'bravm') parts.push('BRAV-M');
+    else parts.push(n === 1 ? `1 ${w.one}` : `${n} ${w.many}`);
+  }
+  return parts.join(' + ');
+}
+
+/** « AVEC VOUS · 3 sections + BRAV-M · en ligne face à la foule » ; '' si personne n'est avec lui. */
+export function groupSummary(units: readonly SummaryUnit[], posture: FollowPosture): string {
+  const c = countText(units);
+  if (c === '') return '';
+  return `${AVEC_VOUS} · ${c} · ${POSTURE_WORDS[posture]}`;
+}
diff --git a/crs-simulation/src/ui/command/direct/tickets.ts b/crs-simulation/src/ui/command/direct/tickets.ts
new file mode 100644
index 0000000..cfe1e0f
--- /dev/null
+++ b/crs-simulation/src/ui/command/direct/tickets.ts
@@ -0,0 +1,234 @@
+/* =====================================================================================
+ * Ordres directs — LES TICKETS : un état par ordre du joueur, de « reçu » à « en place », avec sa raison et son
+ * compte à rebours (logique pure : un réducteur sur des instantanés de la simulation ; P8 en fait le moteur).
+ *
+ *   newTicket(...)                 créé au moment même de l'ordre (état « recu ») ;
+ *   readiness(instantané)          ce que l'unité finit avant d'y aller et dans combien de temps : assis dans les
+ *                                  fourgons (« descend des fourgons », max par véhicule des assis × 0,35 s + 1 s), en
+ *                                  colonne (« en fourgons », reste du trajet / 9 m/s), stationnement (« se garent »,
+ *                                  ≤ 10 s), BRAV-M qui remonte (« remonte sur les motos », 6 s) ;
+ *   next(ticket, instantané, t)    l'état suivant :
+ *     recu      0 à 1 s après l'ordre        « MISTRAL 2 · Bloquer rue de Rivoli · reçu »
+ *     attente   assis, colonne, motos        « MISTRAL 2 · Bloquer · descend des fourgons — prêt dans 5 s »
+ *     route     ≥ 20 % des agents en marche  « MISTRAL 2 · Bloquer rue de Rivoli · en route — 40 m »
+ *     action    interpellation, refoulement  « BRAV-M · Interpeller · poursuite — 12 m »
+ *     en_place  manœuvre faite               « MISTRAL 2 · rue de Rivoli barrée ✓ » (6 s)
+ *     bloque    surveillance (P8)            « MISTRAL 2 · bloqué : la route est barrée — ils finissent à pied »
+ *     refuse    refus                        la phrase du refus (6 s)
+ *     remplace  nouvel ordre à cette unité   (retiré)
+ *   ticketText(ticket)             la ligne ; expired(ticket, t) : à retirer.
+ * La puce d'état, les étiquettes d'ordre de la carte et les tests lisent le même ticket.
+ * ===================================================================================== */
+
+import type { OrderType } from '@/core/contracts';
+import { simRefusal } from './caps';
+import type { DirectVerb } from './types';
+import { VERB_WORDS, atPlace, distText, durationText, placeBare } from './words';
+
+export type TicketState = 'recu' | 'attente' | 'route' | 'action' | 'en_place' | 'bloque' | 'refuse' | 'remplace';
+
+/** Durées (s) : « reçu » au plus, « en place » et « refus » affichés avant retrait. */
+export const RECU_TIME = 1;
+export const SHOW_DONE = 6;
+export const SHOW_REFUSED = 6;
+/** Part minimale des agents en marche pour « en route ». */
+export const ROUTE_SHARE = 0.2;
+/** Sortie d'un agent assis (s, chaque véhicule en parallèle) + 1 s de marge. */
+export const EXIT_PER_AGENT = 0.35;
+/** Vitesse moyenne d'une colonne (m/s), remontée sur les motos (s), stationnement au plus (s). */
+export const CONVOY_SPEED = 9;
+export const REMOUNT_TIME = 6;
+export const PARK_MAX = 10;
+/** Vitesse à pied pour l'ETA « en route » (m/s), sans autre indication. */
+export const FOOT_SPEED = 2.4;
+
+export interface Ticket {
+  id: number;
+  squadId: number;
+  /** Indicatif (« MISTRAL 2 », « FAUCON 1 »). */
+  who: string;
+  verb: DirectVerb;
+  orderType: OrderType | null;
+  /** Lieu sans article (« rue de Rivoli »), '' sinon. */
+  place: string;
+  issuedAt: number;
+  state: TicketState;
+  /** Entrée dans l'état actuel. */
+  since: number;
+  /** Raison (« descend des fourgons », « en fourgons ») et délai (s) pour attente / route / action ; -1 : sans délai. */
+  reason: string;
+  eta: number;
+  /** Distance restante (m) pour « en route », -1 : inconnue. */
+  distance: number;
+  /** Phrase du refus, ou raison du blocage, '' sinon. */
+  why: string;
+}
+
+/** Étape d'un convoi (sim/police/command/convoy.ts). */
+export type ConvoyStage = 'embarquement' | 'depart' | 'route' | 'stationnement' | 'debarquement' | 'annule' | 'fini' | string;
+
+/** Ce que la simulation dit de l'unité à cet instant (P8 le lit ; les tests l'écrivent). */
+export interface TicketSnapshot {
+  /** Agents valides de l'unité, agents assis (hors conducteurs qui ne bougent pas) et assis par véhicule. */
+  agents: number;
+  seated: number;
+  seatedPerVehicle: readonly number[];
+  /** Agents en marche vers le point. */
+  moving: number;
+  /** Distance du centre de l'unité au point (m). */
+  distance: number;
+  /** Colonne : étape, reste du trajet (m), attente restante au stationnement (s). */
+  convoy: { stage: ConvoyStage; remaining: number; waitLeft: number } | null;
+  /** L'ordre attend la fin de la colonne (afterConvoy) : délai estimé (s). */
+  queued: { eta: number } | null;
+  /** BRAV-M : étape (« remontee », « en_selle », « a_pied »…) et temps restant estimé (s). */
+  bravm: { stage: string; eta: number } | null;
+  /** Action en cours : poursuite d'un individu, refoulement, extraction, distance (m). */
+  action: { kind: 'poursuite' | 'refoulement' | 'secours' | 'remise'; distance: number } | null;
+  /** Manœuvre terminée (seuil « en place » du §2.3) ; ok faux : abandonnée avec `reason`. */
+  done: { ok: boolean; reason: string } | null;
+  /** Refus de la simulation (police:order_refused, startTask) : motif brut. */
+  refused: string | null;
+  /** Blocage relevé par la surveillance (P8), en clair (« la route est barrée »). */
+  blocked: string | null;
+  /** Un nouvel ordre du joueur à cette unité remplace celui-ci. */
+  replaced: boolean;
+}
+
+/** Ticket au moment même de l'ordre (état « reçu »). */
+export function newTicket(id: number, squadId: number, who: string, verb: DirectVerb, orderType: OrderType | null, place: string, now: number): Ticket {
+  return {
+    id, squadId, who, verb, orderType, place: placeBare(place), issuedAt: now, state: 'recu', since: now, reason: '', eta: -1, distance: -1, why: '',
+  };
+}
+
+/** Instantané vide (aucune information) : base des tests et du moteur. */
+export function emptySnapshot(): TicketSnapshot {
+  return {
+    agents: 0, seated: 0, seatedPerVehicle: [], moving: 0, distance: -1, convoy: null, queued: null, bravm: null, action: null, done: null,
+    refused: null, blocked: null, replaced: false,
+  };
+}
+
+/** Ce que l'unité finit avant d'y aller, et dans combien de temps (null : rien, elle y va). */
+export function readiness(s: TicketSnapshot): { reason: string; eta: number; state: 'attente' | 'route' } | null {
+  const c = s.convoy;
+  if (s.queued) return { reason: 'à l’arrivée', eta: s.queued.eta, state: 'route' };
+  if (c && c.stage === 'route') return { reason: 'en fourgons', eta: c.remaining / CONVOY_SPEED, state: 'route' };
+  if (c && c.stage === 'stationnement') return { reason: 'se garent', eta: Math.min(PARK_MAX, Math.max(0, c.waitLeft)), state: 'attente' };
+  if (s.bravm && s.bravm.stage === 'remontee') return { reason: 'remonte sur les motos', eta: s.bravm.eta >= 0 ? s.bravm.eta : REMOUNT_TIME, state: 'attente' };
+  if (s.seated > 0) {
+    let worst = 0;
+    for (const n of s.seatedPerVehicle) worst = Math.max(worst, n);
+    if (worst === 0) worst = s.seated;
+    const out = Math.max(0, s.agents - s.seated);
+    const counted = c && (c.stage === 'debarquement' || c.stage === 'embarquement' || c.stage === 'depart') && s.agents > 0 ? ` (${out}/${s.agents})` : '';
+    return { reason: `descend des fourgons${counted}`, eta: worst * EXIT_PER_AGENT + 1, state: 'attente' };
+  }
+  return null;
+}
+
+function enter(t: Ticket, state: TicketState, now: number): Ticket {
+  return state === t.state ? t : { ...t, state, since: now };
+}
+
+/** État suivant du ticket d'après l'instantané (réducteur pur). */
+export function next(t: Ticket, s: TicketSnapshot, now: number): Ticket {
+  if (t.state === 'remplace' || t.state === 'refuse' || t.state === 'en_place') {
+    return s.replaced && t.state !== 'remplace' ? enter(t, 'remplace', now) : t;
+  }
+  if (s.replaced) return enter(t, 'remplace', now);
+  if (s.refused !== null) return { ...enter(t, 'refuse', now), why: simRefusal(t.who, s.refused) };
+  if (s.done) {
+    if (s.done.ok) return { ...enter(t, 'en_place', now), reason: '', eta: -1 };
+    return { ...enter(t, 'refuse', now), why: simRefusal(t.who, s.done.reason) };
+  }
+  if (s.blocked !== null) return { ...enter(t, 'bloque', now), why: s.blocked };
+  // « reçu » d'abord, pendant une seconde (le joueur voit que l'ordre est pris), puis ce que fait l'unité
+  if (t.state === 'recu' && now - t.issuedAt < RECU_TIME) return t;
+  if (s.action) return { ...enter(t, 'action', now), reason: s.action.kind, eta: -1, distance: s.action.distance };
+  const r = readiness(s);
+  if (r) return { ...enter(t, r.state, now), reason: r.reason, eta: r.eta, distance: s.distance };
+  if (s.agents > 0 && s.moving / s.agents >= ROUTE_SHARE) {
+    return { ...enter(t, 'route', now), reason: 'en route', eta: s.distance >= 0 ? s.distance / FOOT_SPEED : -1, distance: s.distance };
+  }
+  // « reçu » une seconde au plus ; ensuite l'état reste celui d'avant (formation sur place)
+  if (t.state === 'recu' && now - t.issuedAt >= RECU_TIME) return { ...enter(t, 'route', now), reason: 'en route', distance: s.distance };
+  return t.state === 'route' ? { ...t, distance: s.distance } : t;
+}
+
+/** Le ticket est à retirer (« en place » et refus après 6 s, remplacé tout de suite). */
+export function expired(t: Ticket, now: number): boolean {
+  if (t.state === 'remplace') return true;
+  if (t.state === 'en_place') return now - t.since >= SHOW_DONE;
+  if (t.state === 'refuse') return now - t.since >= SHOW_REFUSED;
+  return false;
+}
+
+/** Libellé du verbe dans un ticket, avec le lieu quand il y en a un (« Bloquer rue de Rivoli »). */
+export function ticketVerb(t: Pick<Ticket, 'verb' | 'place'>): string {
+  const w = VERB_WORDS[t.verb].label;
+  if (t.place === '') return w;
+  if (t.verb === 'envoyer') return `${w}\u00a0: ${t.place}`;
+  if (t.verb === 'bloquer' || t.verb === 'face_foule' || t.verb === 'disperser' || t.verb === 'tenir' || t.verb === 'repli') return `${w} ${t.place}`;
+  return w;
+}
+
+/** Ce qui est fait, pour « ✓ » (« rue de Rivoli barrée », « au carrefour Voltaire », « interpellé »). */
+export function doneText(t: Pick<Ticket, 'verb' | 'place'>): string {
+  const w = VERB_WORDS[t.verb];
+  if (t.verb === 'bloquer') return t.place !== '' ? `${t.place} ${w.done}` : 'rue barrée';
+  if (t.verb === 'envoyer' || t.verb === 'venir') return t.place !== '' ? atPlace(t.place) : 'sur le point';
+  return w.done;
+}
+
+/** La ligne du ticket (puce d'état, bloc d'ordres, étiquettes de la carte). */
+export function ticketText(t: Ticket): string {
+  const verb = ticketVerb(t);
+  const short = VERB_WORDS[t.verb].label;
+  switch (t.state) {
+    case 'recu':
+      return `${t.who} · ${verb} · reçu`;
+    case 'attente':
+      return `${t.who} · ${short} · ${t.reason}${t.eta >= 0 ? ` — prêt dans ${durationText(t.eta)}` : ''}`;
+    case 'route':
+      if (t.reason === 'en fourgons' || t.reason === 'à l’arrivée') return `${t.who} · ${verb} · ${t.reason}${t.eta >= 0 ? ` — ${durationText(t.eta)}` : ''}`;
+      return `${t.who} · ${verb} · en route${t.distance >= 0 ? ` — ${distText(t.distance)}` : ''}`;
+    case 'action':
+      return `${t.who} · ${short} · ${actionWord(t.reason)}${t.distance >= 0 ? ` — ${distText(t.distance)}` : ''}`;
+    case 'en_place':
+      return `${t.who} · ${doneText(t)} ✓`;
+    case 'bloque':
+      return `${t.who} · bloqué\u00a0: ${t.why} — ils finissent à pied`;
+    case 'refuse':
+      return t.why;
+    case 'remplace':
+      return '';
+    default:
+      return '';
+  }
+}
+
+function actionWord(kind: string): string {
+  switch (kind) {
+    case 'poursuite': return 'poursuite';
+    case 'refoulement': return 'refoulement en cours';
+    case 'secours': return 'secours en cours';
+    case 'remise': return 'remise au fourgon';
+    default: return kind;
+  }
+}
+
+/** Raisons de blocage de la surveillance (raison du pilote automatique → mots). */
+export const BLOCK_WORDS: Readonly<Record<string, string>> = {
+  obstacle: 'la route est barrée',
+  personne: 'un piéton bloque le fourgon de tête',
+  vehicule: 'un véhicule bloque la route',
+  foule: 'la foule barre la route',
+  mur: 'la route est barrée',
+};
+
+/** Mots d'une raison de blocage (inconnue : « la route est barrée »). */
+export function blockWords(reason: string): string {
+  return BLOCK_WORDS[reason] ?? 'la route est barrée';
+}
diff --git a/crs-simulation/src/ui/command/direct/travel.ts b/crs-simulation/src/ui/command/direct/travel.ts
new file mode 100644
index 0000000..9351b4c
--- /dev/null
+++ b/crs-simulation/src/ui/command/direct/travel.ts
@@ -0,0 +1,68 @@
+/* =====================================================================================
+ * Ordres directs — QUAND ROULER (une seule règle pour la fiche, le terrain et le Qui) — logique pure.
+ *
+ *   motorizes(unit, x, z, playerAboard)
+ *     l'unité contient le joueur et il n'est pas à bord d'un de ses véhicules → jamais (sa colonne l'attendrait,
+ *       diag-arrivee P2 : « l'ordre à ma propre unité l'embarque et elle m'attend » ) ;
+ *     engins et voitures de patrouille → toujours (ce sont des véhicules) ;
+ *     BRAV-M en selle → au-delà de BRAVM_RIDE_MIN ; à pied → au-delà de BRAVM_REMOUNT_MIN (ce que fait aujourd'hui
+ *       sim/police/command/bravm.ts : en selle elle roule, à pied elle remonte au-delà de 250 m ; le §4.1.2 — P4 — passe
+ *       ces seuils à 60 m et 150 m dans bravm.ts, et ici dans le même lot, pour que la fiche dise ce qu'elle fait) ;
+ *     au moins la moitié des agents assis dans leurs véhicules et plus de 150 m → en véhicules (colonne implicite) ;
+ *     à pied, plus de 450 m et des véhicules → en véhicules ;
+ *     sinon à pied (au trot au-delà de 15 m).
+ *   travelOf(unit, x, z, playerAboard)   délai, distance et mode pour la fiche et le Qui.
+ * ===================================================================================== */
+
+/** Seuils (m) : assis dans les véhicules, à pied, BRAV-M en selle, BRAV-M à pied, trot. */
+export const SEATED_DRIVE_MIN = 150;
+export const FOOT_DRIVE_MIN = 450;
+export const BRAVM_RIDE_MIN = 0;
+export const BRAVM_REMOUNT_MIN = 250;
+export const TROT_BEYOND = 15;
+/** Vitesses de calcul des délais (m/s) : au pas, au trot, en véhicules. */
+export const WALK_SPEED = 1.4;
+export const TROT_SPEED = 2.4;
+export const DRIVE_SPEED = 11;
+
+/** Ce que la règle lit d'une unité (CardUnit, DirectUnit ou MapUnit conviennent). */
+export interface TravelUnit {
+  x: number;
+  z: number;
+  hasVehicles: boolean;
+  /** Le joueur fait partie de l'unité. */
+  hasPlayer?: boolean;
+  /** Part (0..1) des agents assis dans leurs véhicules ; absente : `embarked` (tous ou aucun). */
+  seatedShare?: number;
+  embarked?: boolean;
+  /** Symbole de carte (UnitSymbol) : engins, BRAV-M. */
+  symbol?: string;
+  patrol?: boolean;
+}
+
+/** Engins qui se déplacent toujours en véhicule. */
+const ROLLING: ReadonlySet<string> = new Set(['centaure', 'canon_eau', 'vehicule', 'drone']);
+
+function seatedShare(u: TravelUnit): number {
+  if (u.seatedShare !== undefined && Number.isFinite(u.seatedShare)) return Math.max(0, Math.min(1, u.seatedShare));
+  return u.embarked ? 1 : 0;
+}
+
+/** L'unité ira-t-elle au point (x, z) en véhicules ? `playerAboard` : le joueur est à bord d'un véhicule de l'unité. */
+export function motorizes(u: TravelUnit, x: number, z: number, playerAboard = false): boolean {
+  const d = Math.hypot(u.x - x, u.z - z);
+  if (u.hasPlayer && !playerAboard) return false;
+  if (u.patrol || (u.symbol !== undefined && ROLLING.has(u.symbol))) return true;
+  const share = seatedShare(u);
+  if (u.symbol === 'bravm') return share >= 0.5 ? d >= BRAVM_RIDE_MIN : d >= BRAVM_REMOUNT_MIN;
+  if (!u.hasVehicles) return false;
+  if (share >= 0.5) return d > SEATED_DRIVE_MIN;
+  return d > FOOT_DRIVE_MIN;
+}
+
+/** Délai (s), distance (m) et mode d'une unité jusqu'au point. */
+export function travelOf(u: TravelUnit, x: number, z: number, playerAboard = false): { eta: number; distance: number; mode: 'pied' | 'vehicules' } {
+  const d = Math.hypot(u.x - x, u.z - z);
+  if (motorizes(u, x, z, playerAboard)) return { eta: d / DRIVE_SPEED, distance: d, mode: 'vehicules' };
+  return { eta: d / (d > TROT_BEYOND ? TROT_SPEED : WALK_SPEED), distance: d, mode: 'pied' };
+}
