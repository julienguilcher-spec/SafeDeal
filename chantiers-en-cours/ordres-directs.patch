+  prev: Map<number, PlayerOrderRecord | null>;
+  /** Sous-unités qui avaient leur propre ordre du joueur, écrasé par la copie de l'ordre de leur unité (parents d'abord). */
+  own: { squadId: number; record: PlayerOrderRecord }[];
