+  noteScreenClosed(): void;
+  /** Dernier point trop loin pour viser, et ouvrir la carte dessus. */
+  farTarget(): FarTarget | null;
+  openFar(): boolean;
+  /** Vue étroite de la partie à cet instant (tests, HUD). */
+  env(): DirectEnv;
