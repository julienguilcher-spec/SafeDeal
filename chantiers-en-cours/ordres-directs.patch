+/** Déplace le joueur (les fonctions de lecture prennent sa position) ; l'index des personnes est refait. */
+function placePlayer(g: Game, x: number, z: number): void {
+  g.me.x = x;
+  g.me.z = z;
+  g.t.ctx.people.rebuildIndex();
+}
