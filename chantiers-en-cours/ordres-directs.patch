+      let target: { x: number; z: number } | null = null;
+      for (let a = 0; a < 16 && !target; a++) {
+        const tx = sec.x + Math.sin(a * Math.PI / 8) * 600;
+        const tz = sec.z + Math.cos(a * Math.PI / 8) * 600;
