+    const { ctx, api } = await start({ place: 'Place de la République', x: 3123, z: -208, extra: { journee: true, base } });
+    const company = ctx.squads.list.find((s) => s.kind === 'compagnie' && s.faction === 'police')!;
+    expect(company).toBeDefined();
