+    for (let j = 0; j < n && around < T.GUARD_CROWD_MIN; j++) {
+      const q = crowdTmp[j];
+      if (q !== p && (q.x - p.x) * (q.x - p.x) + (q.z - p.z) * (q.z - p.z) <= 225) around++;
+    }
+    if (around < T.GUARD_CROWD_MIN) continue;
+    best = i;
+    bestD = d;
+  }
