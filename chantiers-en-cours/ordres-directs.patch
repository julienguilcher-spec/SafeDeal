+// ───────────────────────────── « avec moi » : en garde quand le joueur s'arrête ─────────────────────────────
+
+const crowdTmp: Person[] = [];
+
+const protester = (p: Person): boolean => p.faction === 'protest' && p.vehicleId === 0 && p.custody === 'free' && p.health > 0;
