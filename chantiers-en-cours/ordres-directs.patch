+      const far = vs.filter((v) => Math.hypot(v.x - target!.x, v.z - target!.z) > 220);
+      expect(far.map(desc), `colonne ${pc.convoyOf(who.squadIds[0]!)?.stage} : pas arrivés`).toEqual([]);
+    }, 1200000);
+  }
