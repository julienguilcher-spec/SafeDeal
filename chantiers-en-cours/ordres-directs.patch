+  w = await wheel(['Digit5']);
+  C.check(w.orders.length === 0 && w.screen === 'roue_ordres', 'F 5 sans personne visée : aucun ordre, la roue reste ouverte', w.notes.join(' | '));
+  await snap('6-roue-interpeller');
+  await press('Escape');
