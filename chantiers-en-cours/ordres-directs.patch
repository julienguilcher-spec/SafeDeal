+const ALONG_STREET = [
+  { site: 'celestins', x: 3160.6, z: 1531.3, heading: 0.4310963252425994, width: 5.9 },
+  { site: '1er', x: 768, z: -221.9, heading: 5.9655353833166185, width: 6.7 },
