+  C.check(w.screen === null && (calls1 === calls0 + 1 || w.notes.some((t) => /Pompiers/.test(t))), 'F 7 puis 1 : les pompiers sont demandés', `${calls0} → ${calls1} ; ${w.notes.join(' | ')}`);
