+    game.direct.setDesignation(a.des);
+    game.t.step(0.6);
+    expect(game.direct.ready()!.rule).toBe('g');
+    game.t.step(0.6);
+    // le joueur tourne la tête : la nouvelle ligne s'affiche (l'ancienne était là depuis plus de 0,5 s) et clignote
