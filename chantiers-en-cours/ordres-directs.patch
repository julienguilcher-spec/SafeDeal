+      }
+      // attente du commandant (à pied, la colonne l'attend) : elle se termine au plus tard en cinq minutes
+      let waited = 0;
+      while (pc.convoyOf(who.squadIds[0]!)?.awaitingPlayer && waited < 320) { t.step(5); waited += 5; }
