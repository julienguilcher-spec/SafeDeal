+    const motos = api.entry('9e:faucon9')!.vehicleIds.map((id) => ctx.vehicles.get(id)!).filter((v) => !!v);
+    const leader = ctx.people.get(faucon.leaderId)!;
+    // (les pilotes restent sur leurs machines ; les opérateurs, derrière eux, ont mis pied à terre)
+    const mounted = motos.filter((v) => v.seats.some((id, k) => k > 0 && id !== 0)).length;
+    console.log(`avant le rappel : ${motos.length} motos, ${mounted} avec un opérateur en selle, chef à ${Math.hypot(leader.x - hx, leader.z - hz).toFixed(0)} m des places, motos à ${motos.map((v) => Math.hypot(v.x - hx, v.z - hz).toFixed(0)).join('/')} m`);
+    expect(mounted).toBe(0);
+    expect(Math.hypot(leader.x - hx, leader.z - hz)).toBeLessThan(250);
+    expect(core.issue('retour_poste' as OrderType, [faucon], null).ok).toBe(true);
+    expect(api.entry('9e:faucon9')!.state).toBe('retour');
+    for (let s = 0; s < 240 && api.entry('9e:faucon9')!.state === 'retour'; s++) t.step(2);
+    const e = api.entry('9e:faucon9')!;
+    const far = e.vehicleIds.map((id) => ctx.vehicles.get(id)!).filter((v) => !!v).map((v) => Math.hypot(v.x - hx, v.z - hz));
+    console.log(`après : ${e.state}, motos à ${far.map((d) => d.toFixed(0)).join('/')} m du centre des places`);
+    expect(['repos', 'au_poste']).toContain(e.state);
+    for (const d of far) expect(d).toBeLessThan(40);
+  }, 900_000);
+});
diff --git a/crs-simulation/tests/unit/commissariats.data.test.ts b/crs-simulation/tests/unit/commissariats.data.test.ts
new file mode 100644
index 0000000..e8d009c
--- /dev/null
+++ b/crs-simulation/tests/unit/commissariats.data.test.ts
@@ -0,0 +1,197 @@
+// Commissariats — données figées (pur : aucune carte chargée).
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { createTestContext } from '@/core/testing';
+import { COMMISSARIATS_SERVICE } from '@/gameplay/commissariats/api';
+import { BRAVM_BASES, SERVICE_BASES } from '@/gameplay/session/journee-data';
+import { COMPANY_CALLSIGNS } from '@/sim/police/roster';
+import { createVehicleDefs } from '@/sim/vehicles/defs';
+import {
+  BAC_COLOR, COMMISSARIATS, COMMISSARIAT_SEEDS, STOCK_CALLSIGN_PATTERN, VEHICLE_LEN, VEHICLE_WIDTH, commissariatById,
+  fileCentre, isHeldVehicle, nearestCommissariat, reservedBays,
+} from '@/world/commissariats';
+import { slotsOverlap } from '@/world/commissariats/layout';
+
+/** Emprise de la carte : manifeste des données de Paris s'il est présent, sinon ses valeurs connues. */
+function mapBounds(): { minX: number; minZ: number; maxX: number; maxZ: number } {
+  try {
+    const m = JSON.parse(readFileSync(join(process.cwd(), 'public/data/paris/manifest.json'), 'utf8')) as {
+      bounds: { minX: number; minZ: number; maxX: number; maxZ: number };
+    };
+    return m.bounds;
+  } catch {
+    return { minX: -2656.28, minZ: -1375.38, maxX: 3757.91, maxZ: 1738.61 };
+  }
+}
+
+const allTemplates = COMMISSARIATS.flatMap((c) => c.stock.map((t) => ({ c, t })));
+
+describe('commissariats : données figées', () => {
+  it('sept sites, identifiants uniques, 32 véhicules', () => {
+    expect(COMMISSARIATS).toHaveLength(7);
+    expect(COMMISSARIATS.map((c) => c.id)).toEqual(COMMISSARIAT_SEEDS.map((s) => s.id));
+    expect(new Set(COMMISSARIATS.map((c) => c.id)).size).toBe(7);
+    expect(new Set(allTemplates.map(({ t }) => t.id)).size).toBe(allTemplates.length);
+    const vehicles = allTemplates.reduce((n, { t }) => n + t.vehicles, 0);
+    expect(vehicles).toBe(32);
+    for (const c of COMMISSARIATS) expect(commissariatById(c.id)).toBe(c);
+    expect(commissariatById('inconnu')).toBeUndefined();
+  });
+
+  it('chaque porte et chaque place est à 150 m au moins du bord de la carte', () => {
+    const b = mapBounds();
+    const inside = (x: number, z: number): number => Math.min(x - b.minX, b.maxX - x, z - b.minZ, b.maxZ - z);
+    for (const c of COMMISSARIATS) {
+      expect(inside(c.door.x, c.door.z), c.id).toBeGreaterThanOrEqual(150);
+      expect(inside(c.exit.x, c.exit.z), c.id).toBeGreaterThanOrEqual(150);
+      for (const s of c.slots) expect(inside(s.x, s.z), `${c.id} (${s.x}, ${s.z})`).toBeGreaterThanOrEqual(150);
+    }
+  });
+
+  it('chaque base de journée et de BRAV-M est à moins de 120 m de la porte du site du même arrondissement', () => {
+    for (const base of [...SERVICE_BASES, ...BRAVM_BASES]) {
+      const m = /(\d+)(?:er|e) arrondissement/.exec(base.name);
+      const site = m
+        ? COMMISSARIATS.find((c) => c.kind !== 'prefecture' && c.arrondissement === Number(m[1]))
+        : COMMISSARIATS.find((c) => c.kind === 'prefecture');
+      expect(site, base.name).toBeDefined();
+      const d = Math.hypot(site!.door.x - base.x, site!.door.z - base.z);
+      expect(d, `${base.name} → ${site!.id}`).toBeLessThanOrEqual(120);
+      expect(nearestCommissariat(base.x, base.z)?.id, base.name).toBe(site!.id);
+    }
+  });
+
+  it('chaque unité : autant de places que de véhicules, d\'un seul tenant, dans une seule file, tête d\'abord', () => {
+    for (const { c, t } of allTemplates) {
+      const label = `${c.id} ${t.callsign}`;
+      expect(t.slots, label).toHaveLength(t.vehicles);
+      for (let i = 1; i < t.slots.length; i++) expect(t.slots[i], label).toBe(t.slots[i - 1]! + 1);
+      const file = c.slots[t.slots[0]!]!.file;
+      for (const i of t.slots) {
+        const s = c.slots[i]!;
+        expect(s.file, label).toBe(file);
+        expect(s.spare, label).toBe(false);
+        expect(Math.abs(s.heading - c.slots[t.slots[0]!]!.heading), label).toBeLessThan(0.01);
+      }
+      // la tête est la place la plus en aval (sens du cap) ; les suivantes reculent
+      const head = c.slots[t.slots[0]!]!;
+      const fx = Math.sin(head.heading);
+      const fz = Math.cos(head.heading);
+      for (let k = 1; k < t.slots.length; k++) {
+        const a = c.slots[t.slots[k - 1]!]!;
+        const b = c.slots[t.slots[k]!]!;
+        expect((b.x - a.x) * fx + (b.z - a.z) * fz, label).toBeLessThan(0);
+      }
+    }
+  });
+
+  it('au moins 30 % de places de réserve, dont une file de deux', () => {
+    let total = 0;
+    let vehicles = 0;
+    for (const c of COMMISSARIATS) {
+      const v = c.stock.reduce((n, t) => n + t.vehicles, 0);
+      vehicles += v;
+      total += c.slots.length;
+      expect(c.slots.length, c.id).toBeGreaterThanOrEqual(Math.ceil(1.3 * v));
+      const spares = c.slots.filter((s) => s.spare);
+      expect(spares.length, c.id).toBeGreaterThanOrEqual(2);
+      // chaque place appartient à une seule unité, ou à la réserve
+      const owned = new Set(c.stock.flatMap((t) => t.slots));
+      c.slots.forEach((s, i) => expect(owned.has(i) !== s.spare, `${c.id} place ${i}`).toBe(true));
+    }
+    expect(total).toBeGreaterThanOrEqual(Math.ceil(1.3 * vehicles));
+    expect(reservedBays()).toHaveLength(total);
+  });
+
+  it('aucune place n\'en recouvre une autre ; chaque place contient son véhicule', () => {
+    const defs = new Map(createVehicleDefs().map((d) => [d.kind as string, d]));
+    for (const [kind, len] of Object.entries(VEHICLE_LEN)) {
+      const d = defs.get(kind);
+      if (!d) continue; // voiture_bac : définition facultative (voiture_police à défaut)
+      expect(len, kind).toBeGreaterThanOrEqual(d.length);
+      expect(VEHICLE_WIDTH[kind]!, kind).toBeGreaterThanOrEqual(d.width - 1e-6);
+    }
+    for (const c of COMMISSARIATS) {
+      for (let i = 0; i < c.slots.length; i++) {
+        for (let j = 0; j < i; j++) expect(slotsOverlap(c.slots[i]!, c.slots[j]!, 0.4), `${c.id} ${i}/${j}`).toBe(false);
+      }
+      for (const t of c.stock) {
+        for (const i of t.slots) {
+          expect(c.slots[i]!.len, `${c.id} ${t.callsign}`).toBeGreaterThanOrEqual(VEHICLE_LEN[t.vehicle]!);
+          expect(c.slots[i]!.width, `${c.id} ${t.callsign}`).toBeGreaterThanOrEqual(VEHICLE_WIDTH[t.vehicle]!);
+        }
+      }
+    }
+    // d'un site à l'autre non plus
+    const bays = reservedBays();
+    for (let i = 0; i < bays.length; i++) {
+      for (let j = 0; j < i; j++) {
+        if (bays[i]!.commissariatId === bays[j]!.commissariatId) continue;
+        expect(slotsOverlap(bays[i]!, bays[j]!, 0.4)).toBe(false);
+      }
+    }
+  });
+
+  it('indicatifs uniques, au bon format, hors de la numérotation des compagnies', () => {
+    const calls = allTemplates.map(({ t }) => t.callsign);
+    expect(new Set(calls).size).toBe(calls.length);
+    for (const call of calls) {
+      expect(call).toMatch(STOCK_CALLSIGN_PATTERN);
+      for (const company of COMPANY_CALLSIGNS) expect(call.startsWith(company), call).toBe(false);
+    }
+  });
+
+  it('stock conforme : véhicules hors dispositif non engageables, libellés en français', () => {
+    const cite = commissariatById('cite')!;
+    const hors = cite.stock.filter((t) => t.kind === 'hors_dispositif');
+    expect(hors.map((t) => t.vehicle).sort()).toEqual(['car_crs', 'vl_commandement']);
+    for (const { t } of allTemplates) {
+      expect(t.engageable).toBe(t.kind !== 'hors_dispositif');
+      expect(t.label.length).toBeGreaterThan(5);
+      if (t.kind === 'bac') expect(t.vehicle).toBe('voiture_bac');
+    }
+    expect(commissariatById('9e')!.stock.find((t) => t.kind === 'bravm')).toMatchObject({ callsign: 'FAUCON 9', vehicles: 6, vehicle: 'moto_bravm' });
+    expect(commissariatById('celestins')!.sign).toBe('gendarmerie');
+    expect(cite.sign).toBe('none');
+    expect(BAC_COLOR).toBe(0x2e3238);
+  });
+
+  it('centre de file : milieu des places d\'une unité ; réserve pour une unité adoptée', () => {
+    const c = commissariatById('9e')!;
+    const bravm = c.stock.find((t) => t.kind === 'bravm')!;
+    const f = fileCentre(c, bravm);
+    const a = c.slots[bravm.slots[0]!]!;
+    const b = c.slots[bravm.slots[bravm.slots.length - 1]!]!;
+    expect(f.x).toBeCloseTo((a.x + b.x) / 2, 6);
+    expect(f.z).toBeCloseTo((a.z + b.z) / 2, 6);
+    expect(f.heading).toBe(a.heading);
+    const spare = fileCentre(c, null);
+    const spares = c.slots.filter((s) => s.spare);
+    const near = Math.min(...spares.map((s) => Math.hypot(s.x - spare.x, s.z - spare.z)));
+    expect(near).toBeLessThan(12);
+  });
+
+  it('nearestCommissariat : le plus proche, avec filtre', () => {
+    const cite = commissariatById('cite')!;
+    expect(nearestCommissariat(cite.door.x + 5, cite.door.z)?.id).toBe('cite');
+    expect(nearestCommissariat(cite.door.x, cite.door.z, (c) => c.id !== 'cite')?.id).not.toBe('cite');
+    expect(nearestCommissariat(0, 0, () => false)).toBeNull();
+  });
+});
+
+describe('isHeldVehicle', () => {
+  it('false sans le service, true avec un service qui tient le véhicule', async () => {
+    const t = createTestContext({ modules: [] });
+    await t.ready;
+    expect(isHeldVehicle(t.ctx, 42)).toBe(false);
+    t.ctx.provide(COMMISSARIATS_SERVICE, { holds: (id: number) => id === 42 });
+    expect(isHeldVehicle(t.ctx, 42)).toBe(true);
+    expect(isHeldVehicle(t.ctx, 7)).toBe(false);
+  });
+
+  it('un service sans holds() (forme inattendue) ne tient rien', () => {
+    expect(isHeldVehicle({ service: () => ({}) as never }, 1)).toBe(false);
+    expect(isHeldVehicle({ service: () => undefined }, 1)).toBe(false);
+  });
+});
diff --git a/crs-simulation/tests/unit/commissariats.engage.test.ts b/crs-simulation/tests/unit/commissariats.engage.test.ts
new file mode 100644
index 0000000..5b1954e
--- /dev/null
+++ b/crs-simulation/tests/unit/commissariats.engage.test.ts
@@ -0,0 +1,241 @@
+// Engagement d'unités du stock (vraie carte de Paris, commandant place de la Concorde) : la voiture de Police secours
+// TV 75-19 devient une patrouille « Au poste », trois à bord, engagement idempotent ; la BRAV-M FAUCON 9 sort ses six
+// motos sur ses places, douze policiers en selle ; la section AQUILON 1 ses trois fourgons en file, tout le monde à
+// bord ; envoyée en colonne vers la République, elle est « Engagée » et roule deux tons ; un véhicule garé dans lequel
+// monte le joueur quitte le stock.
+import { describe, expect, it } from 'vitest';
+
+import type { SessionConfig, Vehicle } from '@/core/contracts';
+import { createTestContext } from '@/core/testing';
+import { createSystems as world } from '@/world/query';
+import { createSystems as roles } from '@/sim/roles';
+import { createSystems as people } from '@/sim/people';
+import { createSystems as vehicles } from '@/sim/vehicles';
+import { createSystems as traffic } from '@/sim/traffic';
+import { createSystems as police } from '@/sim/police';
+import { createSystems as law } from '@/gameplay/law';
+import { createSystems as radio } from '@/gameplay/radio';
+import { createSystems as session } from '@/gameplay/session';
+import { createSystems as patrols, PATROLS_SERVICE } from '@/gameplay/patrols';
+import type { PatrolsApi } from '@/gameplay/patrols';
+import {
+  createSystems as commissariats, COMMISSARIATS_SERVICE, COMMISSARIAT_ENGAGED_EVENT,
+} from '@/gameplay/commissariats';
+import type { CommissariatEngagedEvent, CommissariatsApi } from '@/gameplay/commissariats';
+import type { CommandApi } from '@/sim/police/command/api';
+import type { PoliceUnitsApi } from '@/sim/police/api';
+import { commissariatById } from '@/world/commissariats';
+
+const SIM = [world, roles, people, vehicles, traffic, police, law, radio, session, patrols, commissariats];
+const MEANS = { sections: 1, fourgons: 3, centaure: 0, canon_eau: 0, bravm: 0, drone: 0, pompiers: 0, samu: 0, secours_sur_appel: true };
+const REPUBLIQUE = { x: 3123, z: -208 };
+
+async function start(config: Partial<SessionConfig> = {}, seed = 7) {
+  const t = createTestContext({ seed, strict: false, modules: SIM });
+  await t.start({
+    mode: 'libre', role: 'commandant', rank: 'commandant', place: 'Place de la Concorde', x: -10, z: 15, crowdSize: 0,
+    tension: 0.1, volatility: 0.1, duration: 'standard', ...config,
+    extra: { moyens: MEANS, variante: 'salle', foyers: 0, ...(config.extra ?? {}) },
+  } as Partial<SessionConfig>);
+  t.step(1);
+  return { t, ctx: t.ctx, api: t.ctx.require<CommissariatsApi>(COMMISSARIATS_SERVICE) };
+}
+
+/** Places (x, z, cap) d'une unité du stock, tête de file d'abord. */
+function slotsOf(entryId: string): { x: number; z: number; heading: number }[] {
+  const def = commissariatById(entryId.split(':')[0]!)!;
+  const tpl = def.stock.find((s) => s.id === entryId)!;
+  return tpl.slots.map((i) => def.slots[i]!);
+}
+
+function angle(a: number, b: number): number {
+  return Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));
+}
+
+function expectOnSlots(list: readonly Vehicle[], entryId: string): void {
+  const slots = slotsOf(entryId);
+  expect(list.length).toBe(slots.length);
+  for (let i = 0; i < list.length; i++) {
+    expect(Math.hypot(list[i]!.x - slots[i]!.x, list[i]!.z - slots[i]!.z)).toBeLessThan(0.05);
+    expect(angle(list[i]!.heading, slots[i]!.heading)).toBeLessThan(0.01);
+  }
+}
+
+describe('commissariats — engagement', () => {
+  it('TV 75-19 : patrouille au poste, trois à bord, idempotent ; FAUCON 9 : six motos, douze en selle', async () => {
+    const { t, ctx, api } = await start();
+    const engaged: CommissariatEngagedEvent[] = [];
+    ctx.events.onAny(COMMISSARIAT_ENGAGED_EVENT, (e) => engaged.push(e as CommissariatEngagedEvent));
+    const pat = ctx.require<PatrolsApi>(PATROLS_SERVICE);
+    const neuf = api.get('9e')!;
+    expect(neuf.available).toBe(3);
+
+    // Police secours
+    const tv = api.entry('9e:tv19')!;
+    const parked = tv.vehicleIds[0]!;
+    expect(api.holds(parked)).toBe(true);
+    const r = api.engage('9e:tv19', ctx.player.state.personId);
+    expect(r.ok).toBe(true);
+    expect(r.reason).toBe('');
+    expect(r.defaultVerb).toBe('avancer');
+    expect(ctx.vehicles.get(parked)).toBeUndefined();
+    expect(api.holds(parked)).toBe(false);
+    const view = pat.statusOf(r.squadId)!;
+    expect(view.state).toBe('au_poste');
+    expect(view.home).toBe('commissariat du 9e');
+    const car = ctx.vehicles.get(view.vehicleId)!;
+    expectOnSlots([car], '9e:tv19');
+    const squad = ctx.squads.get(r.squadId)!;
+    expect(squad.name).toBe('TV 75-19');
+    expect(squad.members.length).toBe(3);
+    for (const m of squad.members) expect(ctx.people.get(m)!.vehicleId).toBe(car.id);
+    expect(tv.state).toBe('alerte');
+    expect(tv.squadId).toBe(r.squadId);
+    expect(api.entryOf(r.squadId)).toBe(tv);
+    expect(api.isStationUnit(r.squadId)).toBe(true);
+    expect(api.atPost(r.squadId)).toBe(true);
+    expect(engaged).toEqual([{ commissariatId: '9e', entryId: '9e:tv19', squadId: r.squadId, t: ctx.clock.now }]);
+    // (en alerte, toujours compté au commissariat)
+    expect(api.get('9e')!.available).toBe(3);
+    // idempotent : même unité, rien de plus
+    const vehiclesBefore = ctx.vehicles.list.length;
+    const squadsBefore = ctx.squads.list.length;
+    const again = api.engage('9e:tv19');
+    expect(again.ok).toBe(true);
+    expect(again.squadId).toBe(r.squadId);
+    expect(ctx.vehicles.list.length).toBe(vehiclesBefore);
+    expect(ctx.squads.list.length).toBe(squadsBefore);
+    expect(engaged.length).toBe(1);
+
+    // BRAV-M
+    const fb = api.engage('9e:faucon9');
+    expect(fb.ok).toBe(true);
+    expect(fb.defaultVerb).toBe('colonne');
+    const units = ctx.require<PoliceUnitsApi>('police.units');
+    const crew: import('@/core/contracts').Person[] = [];
+    units.members(fb.squadId, crew);
+    expect(crew.length).toBe(12);
+    expect(crew.length).toBe(api.entry('9e:faucon9')!.crew);
+    for (const p of crew) expect(p.vehicleId).not.toBe(0);
+    const group = ctx.squads.get(fb.squadId)!;
+    expect(group.name).toBe('FAUCON 9');
+    const motos = ctx.squads.childrenOf(group.id).map((b) => ctx.vehicles.get(b.vehicleId)!);
+    expect(motos.every((m) => m.kind === 'moto_bravm')).toBe(true);
+    expectOnSlots(motos, '9e:faucon9');
+    expect(ctx.squads.childrenOf(group.id).map((b) => b.name)).toEqual(['FAUCON 9-1', 'FAUCON 9-2', 'FAUCON 9-3', 'FAUCON 9-4', 'FAUCON 9-5', 'FAUCON 9-6']);
+    expect(api.entryOf(ctx.squads.childrenOf(group.id)[2]!.id)!.id).toBe('9e:faucon9');
+    t.step(20);
+    expect(ctx.radio.log.some((m) => m.from === 'TV 75-19' && /Équipage prêt au commissariat du 9e, en attente de destination/.test(m.text))).toBe(true);
+    expect(ctx.radio.log.some((m) => m.from === 'FAUCON 9' && /au commissariat du 9e/.test(m.text))).toBe(true);
+  }, 300000);
+
+  it('toutes les unités engageables : véhicules sur leurs places, effectif annoncé = effectif créé, tout le monde à bord', async () => {
+    const { ctx, api } = await start();
+    const units = ctx.require<PoliceUnitsApi>('police.units');
+    const crew: import('@/core/contracts').Person[] = [];
+    const report: string[] = [];
+    const wrong: string[] = [];
+    for (const site of api.list) {
+      for (const e of site.entries) {
+        if (!e.engageable) {
+          expect(api.engage(e.id).ok).toBe(false);
+          continue;
+        }
+        const r = api.engage(e.id);
+        expect(r.ok, e.id).toBe(true);
+        units.members(r.squadId, crew);
+        report.push(`${e.callsign} ${crew.length}/${e.crew}`);
+        if (crew.length !== e.crew) wrong.push(`${e.callsign} : ${crew.length} créés, ${e.crew} annoncés`);
+        for (const p of crew) expect(p.vehicleId, `${e.callsign} ${p.poste}`).not.toBe(0);
+        const vs = e.vehicleIds.map((id) => ctx.vehicles.get(id)!);
+        expect(vs.every((v) => v.faction === 'police')).toBe(true);
+        expectOnSlots(vs, e.id);
+        expect(e.state).toBe('alerte');
+      }
+    }
+    console.log(report.join(' | '));
+    expect(wrong).toEqual([]);
+    // les deux véhicules hors dispositif restent garés
+    expect(api.entry('cite:car1')!.state).toBe('au_poste');
+    expect(api.holds(api.entry('cite:pc1')!.vehicleIds[0]!)).toBe(true);
+  }, 300000);
+
