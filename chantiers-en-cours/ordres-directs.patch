+  for (let i = 0; i < roots.length; i++) {
+    const r = roots[i];
+    if (r === u || r.id > u.id || !r.order || r.order.type !== 'suivre' || r.man.targetId !== pid || r.squad.kind === 'equipage') continue;
+    idx++;
+  }
+  return idx;
