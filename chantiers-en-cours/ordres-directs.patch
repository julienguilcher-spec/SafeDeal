+    ];
+    const found = new Set<string>();
+    for (const f of files) {
+      const src = readFileSync(f, 'utf8');
+      for (const re of patterns) for (const m of src.matchAll(re)) found.add(m[1]!);
+    }
+    found.delete('refus');
