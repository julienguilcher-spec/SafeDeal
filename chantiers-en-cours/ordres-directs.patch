+    const arrests = ctx.service<ArrestsLike>('police.arrests');
+    if (arrests && typeof arrests.busy === 'function' && arrests.busy(v.id)) return false;
+    const ap = ctx.service<AutopilotLike>('vehicles.autopilot');
+    return !(ap && ap.isActive(v));
+  }
+}
