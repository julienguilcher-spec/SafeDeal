+  const n = ctx.people.queryRadius(x, z, T.GUARD_CROWD, crowdTmp, protester);
+  let best = -1;
+  let bestD = Infinity;
+  for (let i = 0; i < n; i++) {
+    const p = crowdTmp[i];
+    const d = (p.x - x) * (p.x - x) + (p.z - z) * (p.z - z);
+    if (d >= bestD) continue;
