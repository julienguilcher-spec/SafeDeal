+      // la radio dit qui est visé (« Interpellez l'auteur désigné »), le suivi aussi
+      const label = nat.text.split(' · ')[0]!.replace(/^Interpeller\s+/, '');
+      return { ...r, name: label };
+    }
+    if (nat.place !== '') return { ...r, name: `Ici : ${nat.place}` };
+    return r;
+  }
+
+  /** Ligne de fiche de l'ordre prêt (les mêmes fonctions que la fiche de la carte : verbLine). */
+  private lineOf(nat: NaturalOrder, card: CardEnv): CardLine | null {
+    const x = nat.x, z = nat.z;
+    switch (nat.verb) {
+      case 'bloquer':
+        return verbLine(card, 'couper_circulation', 'street', x, z, { targetId: 0 });
+      case 'face_foule':
+        return verbLine(card, 'ligne', 'autoLine', x, z, { label: 'Bloquer ici, face à la foule', explain: 'Une ligne entre vos unités et la foule, boucliers levés.' });
+      case 'envoyer':
+        return verbLine(card, nat.orderType ?? 'colonne', 'point', x, z, { label: 'Y aller' });
+      case 'interpeller':
+      case 'constater':
+        return verbLine(card, 'interpeller', 'target', x, z, { targetId: nat.targetId });
+      case 'disperser':
+        return verbLine(card, 'refoulement', 'point', x, z);
+      default: {
+        const type = nat.orderType;
+        // ordres sur place (tenir, arrêter, agir seuls, tortue) : aucun point à rejoindre
+        return type ? verbLine(card, type, verbOf(type)?.gesture === 'immediate' ? 'immediate' : 'point', x, z) : null;
+      }
+    }
+  }
+
+  /** Disperser après les sommations : l'unité se met en ligne face à la foule, la chaîne légale fait le reste. */
+  private legal(nat: NaturalOrder): GiveResult {
+    const core = this.core;
+    const who = nat.who;
+    if (!who) return this.refuse(REFUS.personne, true);
+    const card = cardEnvFromCore(core, who.squadIds);
+    const where = this.repereOf(nat, card);
+    const line = this.lineOf(nat, card);
+    if (!line) return this.refuse('Cet ordre n’existe pas dans cette version.', true);
+    const r = legalCheck(core, card, line, candidate(who), where);
+    if (!r.chain || !r.plan) return this.refuse(r.reason !== '' ? r.reason : 'Sommations impossibles ici.', true, who, nat.verb);
+    // en attendant, l'unité se met en ligne face à la foule
+    const hold = verbLine(card, 'ligne', 'autoLine', nat.x, nat.z, { label: 'Bloquer ici, face à la foule' });
+    let sent: number[] = [];
+    if (hold) {
+      const h = this.send({ ...nat, verb: 'face_foule' }, hold, who, where, card);
+      if (h.ok) sent = h.squads;
+    }
+    core.legalChain.start(r.plan);
+    return { ok: true, text: r.plan.viaOfficer ? 'Sommations demandées à l’officier sur place' : 'Sommations lancées', squads: sent, ignored: false };
+  }
+
+  /** Secours ici : pompiers (feu) ou SAMU (blessé) au point ; le groupe choisi y va (secourir). */
+  private rescue(nat: NaturalOrder, who: Addressee | null): GiveResult {
+    const core = this.core;
+    const fire = /feu|incendie/i.test(nat.text);
+    const kind: RescueKind = fire ? 'pompiers' : 'samu';
+    let called = false;
+    if (core.rescue && core.scope().canDelegate) {
+      this.field.callRescue(kind, nat.x, nat.z, 0);
+      called = true;
+    } else {
+      called = requestRescueAtPlayer(core, kind);
+    }
+    let squads: number[] = [];
+    if (who && who.squadIds.length > 0) {
+      const list = who.squadIds.map((id) => this.ctx.squads.get(id)).filter((s): s is Squad => !!s);
+      const before = core.verbHint;
+      core.verbHint = 'secours';
+      try {
+        const r = core.issue('secourir', list, [{ x: nat.x, z: nat.z, heading: 0, width: 0, place: nat.place }], nat.personId);
+        if (r.ok) squads = list.map((s) => s.id);
+      } finally {
+        core.verbHint = before;
+      }
+    }
+    if (!called && squads.length === 0) return { ok: false, text: 'Les secours sont déjà demandés.', squads: [], ignored: false };
+    return { ok: true, text: nat.text, squads, ignored: false };
+  }
+
+  /** « Avec moi » à ces unités : à pied s'il est à pied, en colonne derrière lui s'il est à bord. */
+  private withMe(ids: readonly number[], text: string): GiveResult {
+    const core = this.core;
+    const me = core.player();
+    const list = ids.map((id) => this.ctx.squads.get(id)).filter((s): s is Squad => !!s);
+    if (!me || list.length === 0) return { ok: false, text: REFUS.personne, squads: [], ignored: false };
+    const before = core.verbHint;
+    core.verbHint = 'avec_moi';
+    try {
+      const r = core.issue(me.vehicleId !== 0 ? 'avec_moi' : 'suivre_pied', list, null);
+      return r.ok ? { ok: true, text, squads: list.map((s) => s.id), ignored: false } : { ok: false, text: r.reason, squads: [], ignored: false };
+    } finally {
+      core.verbHint = before;
+    }
+  }
+
+  /** Le fourgon cellulaire vient au joueur (sans débarquer) ; ticket « Faire venir ». */
+  private callVan(squadId: number, me: Person): boolean {
+    const cmd = this.ctx.service<CommandLike>('police.command');
+    const s = this.ctx.squads.get(squadId);
+    if (!cmd || typeof cmd.arrive !== 'function' || !s) return false;
+    const lead = s.vehicleId !== 0 ? this.ctx.vehicles.get(s.vehicleId) : undefined;
+    const heading = lead ? Math.atan2(me.x - lead.x, me.z - lead.z) : me.heading;
+    if (!cmd.arrive(squadId, { x: me.x, z: me.z, heading, layout: 'file', boardFirst: false, disembark: false })) return false;
+    const t = newTicket(this.nextTicketId++, s.id, s.name, 'faire_venir', 'colonne', '', this.now());
+    this.addEntry(t, null, 0, me.x, me.z);
+    const d = lead ? Math.hypot(lead.x - me.x, lead.z - me.z) : 0;
+    this.ctx.ui.notify(CUSTODY_TEXTS.vanComing(s.name, d / 6 + 10), 'info', 5);
+    return true;
+  }
+
+  private nearestVanName(x: number, z: number): string {
+    let best = '';
+    let bd = Infinity;
+    for (const s of this.ctx.squads.list) {
+      if (s.vehicleId === 0) continue;
+      const v = this.ctx.vehicles.get(s.vehicleId);
+      if (!v || v.kind !== 'fourgon_cellulaire') continue;
+      const d = Math.hypot(v.x - x, v.z - z);
+      if (d < bd) {
+        bd = d;
+        best = s.name;
+      }
+    }
+    return best !== '' ? best : vanWords('');
+  }
+
+  // ───────────────────────────── A : avec moi ─────────────────────────────
+
+  avecMoi(opts: { fromScreen?: boolean } = {}): GiveResult {
+    if (!opts.fromScreen && this.screenGuard()) return this.ignored();
+    const now = this.now();
+    if (now - this.lastGiveAt < GUARD_TIME) return this.ignored();
+    const core = this.core;
+    const me = core.player();
+    if (!me) return this.refuse(REFUS.personne, true);
+    const env = this.env();
+    const unit = unitOfKey(env, this.who.key);
+    let targets: number[];
+    if (unit) targets = [unit.squadId];
+    else {
+      const own = core.followUnit();
+      targets = (own ? [own.id] : []).concat(this.outsideUnits(own));
+    }
+    if (targets.length === 0) return this.refuse(REFUS.personne, true);
+    const before = this.snapshotOf(targets, 'avec_moi', unit ? unit.name : 'tout le monde');
+    let r: GiveResult;
+    const own = core.followUnit();
+    if (!unit && own) {
+      // son unité entière (sa racine : l'état-major compris), comme « Suivez-moi » ; puis les unités hors de sa racine
+      const verbBefore = core.verbHint;
+      core.verbHint = 'avec_moi';
+      try {
+        const a = core.callFollow(me.vehicleId !== 0);
+        const rest = targets.slice(1);
+        const b = rest.length > 0 ? this.withMe(rest, '') : null;
+        const squads = [...(a.ok ? [own.id] : []), ...(b && b.ok ? b.squads : [])];
+        r = squads.length > 0 ? { ok: true, text: 'Avec moi', squads, ignored: false } : { ok: false, text: a.reason, squads: [], ignored: false };
+      } finally {
+        core.verbHint = verbBefore;
+      }
+    } else r = this.withMe(targets, 'Avec moi');
+    if (r.ok) {
+      this.lastGiveAt = now;
+      this.who = consumeWho(this.who);
+      this.undoEntry = { ...before, at: now };
+      this.evaluate(true);
+    } else if (r.text !== '') this.ctx.ui.notify(r.text, 'warn', 5);
+    return r;
+  }
+
+  /** Unités sous ses ordres qui ne dépendent pas de son unité (attachées), sans les fourgons cellulaires. */
+  private outsideUnits(own: Squad | null): number[] {
+    const core = this.core;
+    const ctx = this.ctx;
+    const scope = core.scope().squadIds;
+    const out: number[] = [];
+    for (const id of scope) {
+      const s = ctx.squads.get(id);
+      if (!s || (own && (s.id === own.id || isUnder(ctx, s.id, own.id)))) continue;
+      if (s.parentId !== 0 && scope.has(s.parentId)) continue;
+      const v = s.vehicleId !== 0 ? ctx.vehicles.get(s.vehicleId) : undefined;
+      if (v && v.kind === 'fourgon_cellulaire') continue;
+      out.push(s.id);
+    }
+    return out.sort((a, b) => a - b);
+  }
+
+  // ───────────────────────────── ⌫ : annuler ─────────────────────────────
+
+  /** État avant l'ordre prêt (pour ⌫) : null si l'ordre ne s'adresse à aucune unité. */
+  private snapshotFor(nat: NaturalOrder): Omit<UndoEntry, 'at'> | null {
+    if (!nat.who || nat.who.squadIds.length === 0) return null;
+    if (nat.verb === 'confier' || nat.verb === 'remettre' || nat.verb === 'emmener' || nat.verb === 'partir' || nat.verb === 'secours') return null;
+    return this.snapshotOf(nat.who.squadIds, nat.verb, nat.who.label);
+  }
+
+  private snapshotOf(targets: readonly number[], verb: DirectVerb, who: string): Omit<UndoEntry, 'at'> {
+    const ctx = this.ctx;
+    const prev = new Map<number, PlayerOrderRecord | null>();
+    const own: UndoEntry['own'] = [];
+    const seen = new Set<number>(targets);
+    for (const id of targets) {
+      const r = this.core.playerOrderRecord(id);
+      prev.set(id, r ? { ...r } : null);
+    }
+    // les sous-unités qui avaient leur propre ordre (le plus récent de leur lignée), parents d'abord
+    const queue = targets.slice();
+    for (let i = 0; i < queue.length && i < 400; i++) {
+      for (const c of ctx.squads.childrenOf(queue[i]!)) {
+        if (seen.has(c.id)) continue;
+        seen.add(c.id);
+        queue.push(c.id);
+        const r = this.core.playerOrderRecord(c.id);
+        if (r && r.squadId === c.id) own.push({ squadId: c.id, record: { ...r } });
+      }
+    }
+    return { who, verb, targets: targets.slice(), prev, own };
+  }
+
+  undoable(): UndoInfo | null {
+    const u = this.undoEntry;
+    if (!u) return null;
+    const until = u.at + UNDO_WINDOW;
+    if (this.now() > until) return null;
+    return { who: u.who, verb: VERB_WORDS[u.verb].label, until };
+  }
+
+  undo(): GiveResult {
+    if (this.screenGuard()) return this.ignored();
+    const u = this.undoEntry;
+    if (!u || this.now() - u.at > UNDO_WINDOW) {
+      this.undoEntry = null;
+      return this.ignored();
+    }
+    this.undoEntry = null;
+    const core = this.core;
+    const done: number[] = [];
+    for (const id of u.targets) {
+      const s = this.ctx.squads.get(id);
+      if (!s) continue;
+      const prev = u.prev.get(id) ?? null;
+      if (prev) {
+        if (core.reissue(s, prev)) done.push(id);
+      } else if (u.verb !== 'avec_moi') {
+        // aucun ordre du joueur avant : l'unité revient avec lui
+        if (core.reissue(s, followRecord(s.id, this.now()))) done.push(id);
+      }
+    }
+    for (const o of u.own) {
+      const s = this.ctx.squads.get(o.squadId);
+      if (s && core.reissue(s, o.record)) done.push(s.id);
+    }
+    this.evaluate(true);
+    return { ok: done.length > 0, text: done.length > 0 ? `Ordre annulé — ${u.who}` : '', squads: done, ignored: done.length === 0 };
+  }
+
+  // ───────────────────────────── carte (trop loin) ─────────────────────────────
+
+  farTarget(): FarTarget | null {
+    return this.far;
+  }
+
+  openFar(): boolean {
+    const f = this.far;
+    if (!f) return false;
+    this.ctx.ui.open('carte_tactique', { x: f.x, z: f.z, squadIds: f.squadIds, intent: f.intent });
+    return true;
+  }
+
+  // ───────────────────────────── tickets ─────────────────────────────
+
+  get tickets(): readonly Ticket[] {
+    return this.list;
+  }
+
+  ticketOf(squadId: number): Ticket | null {
+    for (let i = this.entries.length - 1; i >= 0; i--) {
+      const e = this.entries[i]!;
+      if (e.ticket.squadId === squadId && e.ticket.state !== 'remplace') return e.ticket;
+    }
+    return null;
+  }
+
+  /** Un ordre du joueur vient d'être posé (CommandCore.issue) : son ticket, à l'instant même (« reçu »). */
+  private onRecord(r: PlayerOrderRecord): void {
+    const s = this.ctx.squads.get(r.squadId);
+    if (!s) return;
+    if (!r.verb) {
+      // un ordre sans verbe direct (embarquer, protéger…) remplace quand même le ticket de l'unité
+      this.replace(s.id);
+      return;
+    }
+    const t = newTicket(this.nextTicketId++, s.id, s.name, r.verb, r.type, r.place, r.issuedAt);
+    const g = r.geom;
+    const me = this.core.player();
+    const lead = s.leaderId !== 0 ? this.ctx.people.get(s.leaderId) : undefined;
+    const x = g ? g.x : r.verb === 'avec_moi' && me ? me.x : lead ? lead.x : 0;
+    const z = g ? g.z : r.verb === 'avec_moi' && me ? me.z : lead ? lead.z : 0;
+    this.addEntry(t, r, r.targetId > 0 && (r.verb === 'interpeller' || r.verb === 'constater') ? r.targetId : 0, x, z);
+  }
+
+  private replace(squadId: number): void {
+    const now = this.now();
+    for (const e of this.entries) {
+      if (e.ticket.squadId !== squadId || e.ticket.state === 'remplace') continue;
+      e.ticket = { ...e.ticket, state: 'remplace', since: now };
+    }
+  }
+
+  private addEntry(t: Ticket, record: PlayerOrderRecord | null, personId: number, x = 0, z = 0): void {
+    this.replace(t.squadId);
+    this.entries.push({
+      ticket: t, record, x, z, personId, done: null, refused: null, blocked: null, blockedAt: -1e9, watch: [], watchUsed: false,
+      changedAt: t.issuedAt,
+    });
+    this.prune();
+  }
+
+  private prune(): void {
+    const now = this.now();
+    for (let i = this.entries.length - 1; i >= 0; i--) {
+      const e = this.entries[i]!;
+      if (expired(e.ticket, now) || (now - e.changedAt > TICKET_STALE && e.ticket.state !== 'refuse')) this.entries.splice(i, 1);
+    }
+    while (this.entries.length > TICKETS_MAX) this.entries.shift();
+    this.list.length = 0;
+    for (const e of this.entries) if (e.ticket.state !== 'remplace') this.list.push(e.ticket);
+  }
+
+  /** Événements de la simulation : fin d'une manœuvre, formation en place, refus. */
+  onPoliceEvent(kind: 'done' | 'in_place' | 'refused', e: DoneEvent): void {
+    if (!e || typeof e.squadId !== 'number') return;
+    if (kind !== 'refused') this.core.notePoliceDone(e.squadId, kind === 'done' ? e.type ?? null : null, kind === 'in_place' ? true : e.ok === true);
+    const ctx = this.ctx;
+    for (const en of this.entries) {
+      const t = en.ticket;
+      if (t.state === 'remplace' || t.state === 'en_place' || t.state === 'refuse') continue;
+      const own = e.squadId === t.squadId;
+      const under = !own && TASK_VERBS.has(t.verb) && isUnder(ctx, e.squadId, t.squadId);
+      if (!own && !under) continue;
+      const s = ctx.squads.get(t.squadId);
+      if (!s) continue;
+      const type = kind === 'in_place' ? s.order.type : e.type;
+      if (t.orderType && type !== t.orderType) continue;
+      if (kind === 'in_place') {
+        if (s.order.issuedAt + 1e-6 < t.issuedAt) continue;
+        en.done = { ok: true, reason: '' };
+      } else if (kind === 'done') {
+        // un abandon sans motif (ordre remplacé) n'est pas un refus à dire
+        if (e.ok !== true && (!e.reason || e.reason === '')) continue;
+        en.done = { ok: e.ok === true, reason: e.reason ?? '' };
+      } else {
+        en.refused = e.reason ?? '';
+      }
+    }
+  }
+
+  /**
+   * Étape d'une colonne ('command:convoy') : un mouvement en véhicules sans ordre à reprendre au débarquement (« Faire
+   * mouvement », « Y aller » loin) est fait quand la colonne est en place.
+   */
+  onConvoyStage(squadId: number, stage: string): void {
+    if (stage !== 'en_place') return;
+    for (const en of this.entries) {
+      const t = en.ticket;
+      if (t.squadId !== squadId || en.done || t.state === 'remplace' || t.state === 'en_place' || t.state === 'refuse') continue;
+      if (this.core.afterConvoy.has(squadId)) continue;
+      if (t.orderType === 'faire_mouvement' || t.orderType === 'colonne' || t.orderType === 'avancer') en.done = { ok: true, reason: '' };
+    }
+  }
+
+  /** À chaque pas de la simulation : écrans, tickets, surveillance. */
+  update(): void {
+    this.trackScreens();
+    if (this.entries.length === 0) return;
+    const now = this.now();
+    // tickets relus quatre fois par seconde (la ligne d'état n'en demande pas plus)
+    if (now - this.ticketAt < TICKET_PERIOD) return;
+    this.ticketAt = now;
+    const watch = now - this.watchAt >= WATCH_PERIOD;
+    if (watch) this.watchAt = now;
+    for (const e of this.entries) {
+      const t = e.ticket;
+      if (t.state === 'remplace') continue;
+      if (!this.ctx.squads.get(t.squadId)) {
+        e.ticket = { ...t, state: 'remplace', since: now };
+        continue;
+      }
+      const snap = this.snapshot(e);
+      if (watch) this.watchdog(e, snap);
+      if (e.blocked !== null && now - e.blockedAt > BLOCK_SHOW) e.blocked = null;
+      snap.blocked = e.blocked;
+      const n = next(t, snap, now);
+      if (n.state !== t.state) e.changedAt = now;
+      e.ticket = n;
+    }
+    this.prune();
+  }
+
+  /** Ce que la simulation dit de l'unité du ticket à cet instant. */
+  private snapshot(e: TicketEntry): TicketSnapshot {
+    const ctx = this.ctx;
+    const core = this.core;
+    const t = e.ticket;
+    const snap = emptySnapshot();
+    const s = ctx.squads.get(t.squadId)!;
+    const me = core.player();
+    const meId = me ? me.id : 0;
+    // le point suivi : le joueur (Avec moi), la personne à interpeller
+    if (t.verb === 'avec_moi' && me) {
+      e.x = me.x;
+      e.z = me.z;
+    } else if (e.personId !== 0) {
+      const p = ctx.people.get(e.personId);
+      if (p) {
+        e.x = p.x;
+        e.z = p.z;
+      }
+    }
+    const perVehicle = new Map<number, number>();
+    let sx = 0, sz = 0, n = 0, nearest = Infinity;
+    const walk = (q: Squad, depth: number): void => {
+      for (const id of q.members) {
+        if (id === meId) continue;
+        const p = ctx.people.get(id);
+        if (!p || ctx.health.isIncapacitated(p)) continue;
+        snap.agents++;
+        if (p.vehicleId !== 0) {
+          const v = ctx.vehicles.get(p.vehicleId);
+          // le conducteur reste au volant : il ne « descend » pas
+          const driver = v ? v.def.seats.some((seat, i) => seat.role === 'driver' && v.seats[i] === p.id) : false;
+          if (!driver) {
+            snap.seated++;
+            perVehicle.set(p.vehicleId, (perVehicle.get(p.vehicleId) ?? 0) + 1);
+          }
+          const vx = v ? v.x : p.x, vz = v ? v.z : p.z;
+          sx += vx;
+          sz += vz;
+        } else {
+          sx += p.x;
+          sz += p.z;
+          if (Math.hypot(p.vx, p.vz) > MOVING_SPEED) snap.moving++;
+        }
+        n++;
+        nearest = Math.min(nearest, Math.hypot(p.x - e.x, p.z - e.z));
+      }
+      if (depth < 8) for (const c of ctx.squads.childrenOf(q.id)) walk(c, depth + 1);
+    };
+    walk(s, 0);
+    snap.seatedPerVehicle = [...perVehicle.values()];
+    snap.distance = n > 0 ? Math.hypot(sx / n - e.x, sz / n - e.z) : -1;
+    const phase = core.phaseOf(s.id);
+    if (phase.convoy) snap.convoy = { stage: phase.convoy.stage, remaining: phase.convoy.remaining, waitLeft: phase.convoy.departIn };
+    if (phase.bravm) snap.bravm = { stage: phase.bravm, eta: -1 };
+    snap.done = e.done;
+    snap.refused = e.refused;
+    // fins qui ne passent pas par un événement
+    if (!snap.done && now(ctx) - t.issuedAt >= 1) {
+      if (t.verb === 'avec_moi' && this.followsPlayer(s, meId)) snap.done = { ok: true, reason: '' };
+      else if (t.orderType && IMMEDIATE_DONE.has(t.orderType)) snap.done = { ok: true, reason: '' };
+      else if ((t.verb === 'faire_venir' || t.verb === 'venir') && s.vehicleId !== 0) {
+        const v = ctx.vehicles.get(s.vehicleId);
+        if (v && Math.hypot(v.x - e.x, v.z - e.z) < 20) snap.done = { ok: true, reason: '' };
+      }
+    }
+    // action en cours : poursuite d'un individu, refoulement, secours
+    if (!snap.done) {
+      if ((t.verb === 'interpeller' || t.verb === 'constater') && e.personId !== 0) {
+        const p = ctx.people.get(e.personId);
+        if (p && p.custody === 'free' && nearest < 60) snap.action = { kind: 'poursuite', distance: nearest };
+        else if (p && p.custody !== 'free') snap.action = { kind: 'remise', distance: -1 };
+      } else if (t.verb === 'disperser' && s.order.type === 'refoulement' && snap.moving > 0 && snap.distance < 30) {
+        snap.action = { kind: 'refoulement', distance: -1 };
+      } else if (t.verb === 'secours' && snap.distance >= 0 && snap.distance < 15) {
+        snap.action = { kind: 'secours', distance: -1 };
+      }
+    }
+    return snap;
+  }
+
+  private followsPlayer(s: Squad, meId: number): boolean {
+    const o = s.order;
+    if (meId !== 0 && o.type === 'suivre' && o.targetId === meId) return true;
+    if (o.type === 'avec_moi') return true;
+    const f = this.ctx.service<FollowLike>('session.follow');
+    return !!f && typeof f.inColumn === 'function' && f.inColumn(s.id);
+  }
+
+  /**
+   * Surveillance (§2.5) : en route, l'unité (ou son véhicule de tête) s'est-elle rapprochée de 5 m en 15 s ? Sinon,
+   * « bloqué » avec la raison du pilote automatique, et — une fois, à moins de 400 m du point — elle quitte sa colonne,
+   * descend là où elle est et finit à pied (l'ordre est redonné à pied).
+   */
+  private watchdog(e: TicketEntry, snap: TicketSnapshot): void {
+    const t = e.ticket;
+    const c = snap.convoy;
+    // pas de surveillance : « Avec moi », hors route, déjà sur place, ou colonne qui attend encore son départ
+    if (e.watchUsed || t.verb === 'avec_moi' || t.state !== 'route' || snap.distance < 0 || snap.distance < WATCH_NEAR || snap.done
+      || (c !== null && (c.stage !== 'route' || c.waitLeft > 0 || snap.distance < WATCH_CONVOY_NEAR))) {
+      e.watch.length = 0;
+      return;
+    }
+    const now = this.now();
+    // progrès : l'unité elle-même (centre), ou sa colonne (itinéraire restant de la tête)
+    e.watch.push({ t: now, d: snap.distance, r: c ? c.remaining : -1 });
+    while (e.watch.length > 1 && now - e.watch[1]!.t >= WATCH_WINDOW) e.watch.shift();
+    const first = e.watch[0]!;
+    if (now - first.t < WATCH_WINDOW || first.d - snap.distance >= WATCH_GAIN) return;
+    if (c && first.r >= 0 && first.r - c.remaining >= WATCH_GAIN) return;
+    if (snap.distance > WATCH_RELEASE) {
+      // trop loin pour finir à pied : la colonne garde la main (la ligne ne promet pas « à pied »)
+      e.watch.length = 0;
+      return;
+    }
+    e.watchUsed = true;
+    e.watch.length = 0;
+    e.blocked = blockWords(this.blockReason(t.squadId, snap));
+    e.blockedAt = now;
+    this.finishOnFoot(e);
+  }
+
+  /** Raison d'un blocage : celle du pilote automatique du véhicule de l'unité, sinon la foule ou la route barrée. */
+  private blockReason(squadId: number, snap: TicketSnapshot): string {
+    const ctx = this.ctx;
+    const ap = ctx.service<AutopilotLike>('vehicles.autopilot');
+    for (let q = ctx.squads.get(squadId), guard = 0; q && guard < 9; q = q.parentId !== 0 ? ctx.squads.get(q.parentId) : undefined, guard++) {
+      const v = q.vehicleId !== 0 ? ctx.vehicles.get(q.vehicleId) : undefined;
+      if (v && ap && typeof ap.status === 'function') {
+        const r = ap.status(v).reason;
+        if (r && r !== '') return r;
+      }
+    }
+    return snap.seated > snap.agents / 2 ? 'obstacle' : 'foule';
+  }
+
+  /** L'unité quitte sa colonne et redonne l'ordre à pied (elle descend d'abord : sim/police/maneuver.ts). */
+  private finishOnFoot(e: TicketEntry): void {
+    const ctx = this.ctx;
+    const core = this.core;
+    const r = e.record;
+    const s = ctx.squads.get(e.ticket.squadId);
+    if (!s || !r || !r.geom) return;
+    core.afterConvoy.delete(s.id);
+    // libérée de sa colonne tout de suite (un ordre sans point : police.command.takeOver la libère où qu'elle soit)
+    ctx.service<CommandLike>('police.command')?.takeOver?.(s.id, { type: r.type, byPlayer: true });
+    ctx.service<FollowLike>('session.follow')?.release?.(s.id);
+    const g = r.geom;
+    ctx.squads.issue(s.id, {
+      type: r.type, x: g.x, z: g.z, heading: g.heading, width: g.width, targetId: r.targetId, maxForce: core.effectiveForce(),
+      issuedBy: ctx.player.state.personId, place: r.place, byPlayer: true,
+    });
+    r.done = false;
+  }
+
+  /** Nouvelle session : tout est oublié. */
+  reset(): void {
+    this.external = null;
+    this.shown = null;
+    this.evalAt = -1e9;
+    this.readAt = -1e9;
+    this.who = WHO_AUTO;
+    this.lastGiveAt = -1e9;
+    this.closedAt = -1e9;
+    this.legalPress = null;
+    this.undoEntry = null;
+    this.far = null;
+    this.watchAt = -1e9;
+    this.ticketAt = -1e9;
+    this.entries.length = 0;
+    this.list.length = 0;
+  }
+}
+
+function now(ctx: GameContext): number {
+  return ctx.clock.now;
+}
+
+/** L'unité `id` est-elle sous l'unité `ancestor` (à un niveau quelconque) ? */
+function isUnder(ctx: GameContext, id: number, ancestor: number): boolean {
+  let s = ctx.squads.get(id);
+  for (let guard = 0; s && guard < 9; guard++) {
+    if (s.parentId === ancestor) return true;
+    s = s.parentId !== 0 ? ctx.squads.get(s.parentId) : undefined;
+  }
+  return false;
+}
+
+/** « Avec moi » comme ordre du joueur à redonner (annulation sans ordre précédent). */
+function followRecord(squadId: number, t: number): PlayerOrderRecord {
+  return { squadId, type: 'suivre_pied', verb: 'avec_moi', geom: null, targetId: 0, issuedAt: t, place: '', done: false };
+}
+
+/** Qui de la carte pour une unité choisie par les ordres directs. */
+function candidate(who: Addressee): WhoCandidate {
+  return { squadIds: who.squadIds.slice(), label: who.label, mode: 'pied', eta: 0, distance: who.distance, busy: who.leaves };
+}
diff --git a/crs-simulation/src/ui/command/direct/sector.ts b/crs-simulation/src/ui/command/direct/sector.ts
new file mode 100644
index 0000000..69c7fe7
--- /dev/null
+++ b/crs-simulation/src/ui/command/direct/sector.ts
@@ -0,0 +1,303 @@
+/* =====================================================================================
+ * Ordres directs — LES SECTEURS DE LA ROUE (F) en ordres (logique pure, déterministe).
+ *
+ *   sectorOrder(secteur, situation)   l'ordre d'un secteur de la roue (Envoyer, Bloquer une rue, Interpeller, Disperser,
+ *                                     et la couronne « Plus… ») sur ce que le joueur désigne, adressé à la MÊME unité que
+ *                                     l'ordre prêt (« À qui » : who.ts resolveWho, choix U compris) — jamais la racine de
+ *                                     la compagnie. Le résultat a la forme de l'ordre prêt (NaturalOrder) : le moteur
+ *                                     (runtime.ts giveSector) l'envoie par le même chemin que Entrée (ligne de fiche de
+ *                                     la carte, Qui, sendCardLine) ;
+ *   sectorItemText(ordre)             la deuxième ligne du secteur : l'unité qui obéira (« MISTRAL 1 · 90 m »), ou la
+ *                                     raison du verrou en quelques mots (« sommations d'abord »).
+ *
+ * Verrous (§4.3) : un ordre de force que la loi ne permet pas encore reste grisé avec sa raison ; Disperser avant les
+ * 3 sommations, et Charger / Gaz / Bond quand le commandant (l'autorité) doit d'abord donner son accord : le premier
+ * appui dit pourquoi, le second dans les 3 s fait faire les sommations (et l'accord) — `legalFirst`. Sans autorité :
+ * « Charger demande l'accord du commandant. Demandez-le à la radio (T). », aucun ordre.
+ * « Avec moi » (1) et la couronne « Secours ici » (7) ne sont pas des ordres de ce module : la roue appelle « Avec moi »
+ * du moteur (A) et la demande de secours du HUD.
+ * ===================================================================================== */
+
+import type { OrderType } from '@/core/contracts';
+import { verbOf } from '../orders';
+import { REFUS, capRefusal, refusForce } from './caps';
+import type { NaturalOrder, NaturalRule } from './natural';
+import { RANGE } from './natural';
+import type { Addressee, Designation, DirectEnv, DirectVerb, WhoKey } from './types';
+import { resolveWho, whyNobody } from './who';
+import type { DirectSector } from './words';
+import { VERB_WORDS, distText, pillWhoText, placeBare, placeWithArticle } from './words';
+
+/** Recul d'un repli ordonné depuis la roue (m), comme l'ancienne roue. */
+export const REPLI_DISTANCE = 30;
+/** Foule autour du point pour « Bloquer une rue » face à elle et pour Disperser (rayon, m). */
+export const SECTOR_CROWD_RADIUS = 30;
+
+/** Ce que la roue sait de la situation à son ouverture. */
+export interface SectorSituation {
+  env: DirectEnv;
+  /** Ce que le joueur désigne (designate.ts), relevé à l'ouverture de la roue. */
+  des: Designation;
+  /** Choix « À qui » en cours (U). */
+  whoKey: WhoKey;
+  /** Droit : force autorisée, riposte en cours, le joueur est l'autorité qui donne l'accord (commandant). */
+  law: { authorizedForce: number; underAttack: boolean; authority: boolean };
+  /** Cap de la caméra (rad) : le repli se fait vers l'arrière du regard. */
+  yaw: number;
+}
+
+/** Raison courte d'un secteur verrouillé (deuxième ligne du secteur, ≤ 3 lignes de 19 signes). */
+export const SECTOR_LOCKS = {
+  sommations: 'sommations d’abord',
+  accord: 'il faut votre accord',
+  accordChef: 'accord du commandant',
+  visezQuelquun: 'visez quelqu’un',
+  visezFoule: 'visez la foule',
+  visezPoint: 'visez un point',
+  tropLoin: 'trop loin : Tab',
+  personne: 'personne pour cela',
+  capacite: 'pas cette unité',
+} as const;
+
+/** Phrases des refus propres à la roue (le reste vient de caps.ts, §4.3). */
+export const SECTOR_REFUS = {
+  visezQuelquun: 'Interpeller : visez la personne, puis F et 5.',
+  visezFoule: 'Disperser : visez la foule, puis F et 6.',
+} as const;
+
+function blank(rule: NaturalRule, verb: DirectVerb, x: number, z: number, distance: number): NaturalOrder {
+  return {
+    rule, verb, enabled: true, text: '', short: VERB_WORDS[verb].short, whoShort: '', who: null, x, z, heading: 0, distance, place: '',
+    orderType: null, intent: null, targetId: 0, personId: 0, lock: null, legalFirst: false, autre: null, key: '',
+  };
+}
+
+function finish(o: NaturalOrder, sectorKey: string): NaturalOrder {
+  o.key = ['roue', sectorKey, o.verb, o.who ? o.who.squadIds.join('+') : '-', o.place, o.personId, o.enabled ? 1 : 0, o.legalFirst ? 1 : 0].join('|');
+  return o;
+}
+
+/** Verrou dans la ligne et sa raison courte (le texte court est rangé dans `whoShort`, lu par sectorItemText). */
+function lockWith(o: NaturalOrder, sentence: string, short: string): void {
+  o.enabled = false;
+  o.lock = sentence;
+  o.whoShort = short;
+}
+
+/**
+ * QUI pour le verbe au point (`at` : où chercher l'unité, le point de l'ordre par défaut) ; sans unité, ou unité qui ne
+ * sait pas faire : ligne grise avec la phrase.
+ */
+function address(s: SectorSituation, o: NaturalOrder, phrase: string, showDistance: boolean, at: { x: number; z: number } = o): Addressee | null {
+  const who = resolveWho(s.env, s.whoKey, o.verb, at.x, at.z);
+  o.who = who;
+  o.text = phrase;
+  if (!who) {
+    lockWith(o, whyNobody(o.verb, s.env), SECTOR_LOCKS.personne);
+    return null;
+  }
+  const parts = [phrase, who.leaves !== '' ? `${who.label} (${who.leaves})` : who.label];
+  if (showDistance) parts.push(distText(o.distance));
+  o.text = parts.join(' · ');
+  o.whoShort = pillWhoText(who.label, showDistance ? o.distance : null);
+  if (who.squadIds.length === 1) {
+    const u = s.env.units.find((q) => q.squadId === who.squadIds[0]);
+    const refusal = u ? capRefusal(u.kind, o.verb) : null;
+    if (refusal) lockWith(o, refusal, SECTOR_LOCKS.capacite);
+  }
+  return who;
+}
+
+/** Ordre de force : verrou de la loi (accord, sommations), ou rien. */
+function forceLock(s: SectorSituation, o: NaturalOrder, type: OrderType): void {
+  if (!o.enabled) return;
+  const v = verbOf(type);
+  if (!v) return;
+  const forceMissing = v.force > s.law.authorizedForce && !s.law.underAttack;
+  const sommationsMissing = v.coercive && s.env.sommations < 3 && !s.env.riposteAt(o.x, o.z);
+  if (forceMissing) {
+    if (s.law.authority) {
+      // le commandant : le second appui fait faire les sommations et donne son accord (chaîne légale)
+      o.legalFirst = true;
+      o.lock = refusForce(o.verb, true);
+      o.whoShort = sommationsMissing ? SECTOR_LOCKS.sommations : SECTOR_LOCKS.accord;
+    } else lockWith(o, refusForce(o.verb, false), SECTOR_LOCKS.accordChef);
+    return;
+  }
+  // Disperser : jamais avant les 3 sommations (hors riposte) — le second appui les fait faire, l'unité en ligne
+  if (o.verb === 'disperser' && sommationsMissing && o.who) {
+    o.legalFirst = true;
+    o.lock = REFUS.disperserSommations(o.who.label);
+    o.whoShort = SECTOR_LOCKS.sommations;
+  }
+}
+
+/** Le point visé est-il exploitable (ni ciel, ni mur à moins de 6 m) ? Sinon la ligne grise de la règle i. */
+function pointOk(s: SectorSituation, o: NaturalOrder): boolean {
+  if (s.des.kind === 'none' || (s.des.distance < RANGE.minPoint && s.des.kind !== 'person')) {
+    lockWith(o, REFUS.rien, SECTOR_LOCKS.visezPoint);
+    return false;
+  }
+  return true;
+}
+
+/** Lieu nommé du point : celui de la désignation, sinon la rue, sinon le secteur. */
+function placeOf(s: SectorSituation, x: number, z: number): string {
+  const named = s.des.place !== '' ? s.des.place : s.env.roadAt(x, z, 40)?.name ?? s.env.placeName(x, z);
+  return placeBare(named);
+}
+
+/**
+ * L'ordre d'un secteur de la roue sur la désignation. null : le secteur n'est pas un ordre à une unité (« Avec moi »,
+ * couronnes, appels de secours) — la roue s'en charge.
+ */
+export function sectorOrder(sector: DirectSector, s: SectorSituation): NaturalOrder | null {
+  const des = s.des;
+  const x = des.x, z = des.z, d = des.distance;
+  const key = String(sector.key) + (sector.orders[0] ? `:${String(sector.orders[0])}` : '');
+  switch (sector.action) {
+    case 'envoyer': {
+      const o = blank('h', 'envoyer', x, z, d);
+      o.intent = 'envoyer';
+      o.orderType = s.env.demonstratorsAt(x, z, RANGE.nearCrowd).count >= RANGE.crowdMin ? 'avancer' : 'colonne';
+      if (!pointOk(s, o)) {
+        o.text = 'Envoyer';
+        return finish(o, key);
+      }
+      o.place = placeOf(s, x, z);
+      address(s, o, o.place !== '' ? `Envoyer : ${o.place}` : 'Envoyer ici', true);
+      if (o.enabled && d > RANGE.send) lockWith(o, REFUS.tropLoin, SECTOR_LOCKS.tropLoin);
+      return finish(o, key);
+    }
+    case 'bloquer': {
+      const crowd = s.env.demonstratorsAt(x, z, SECTOR_CROWD_RADIUS);
+      const road = s.env.roadAt(x, z, RANGE.road);
+      if (crowd.count >= RANGE.crowdMin || !road) {
+        // une foule à 30 m : la ligne face à elle ; ni foule ni rue : une ligne au point, face au regard
+        const o = blank('f', 'face_foule', x, z, d);
+        o.orderType = 'ligne';
+        o.intent = 'bloquer';
+        if (!pointOk(s, o)) {
+          o.text = 'Bloquer ici';
+          return finish(o, key);
+        }
+        o.place = road ? placeBare(road.name) : placeOf(s, x, z);
+        const p = s.env.player;
+        const dx = crowd.x - x, dz = crowd.z - z;
+        o.heading = crowd.count >= RANGE.crowdMin && Math.hypot(dx, dz) > 1 ? Math.atan2(dx, dz) : p ? Math.atan2(x - p.x, z - p.z) : s.yaw;
+        address(s, o, crowd.count >= RANGE.crowdMin ? 'Bloquer ici, face à la foule' : 'Bloquer ici', true);
+        if (o.enabled && d > RANGE.send) lockWith(o, REFUS.tropLoin, SECTOR_LOCKS.tropLoin);
+        return finish(o, key);
+      }
+      const o = blank('g', 'bloquer', road.x, road.z, d);
+      o.orderType = 'couper_circulation';
+      o.intent = 'bloquer';
+      o.heading = road.heading;
+      o.place = placeBare(road.name);
+      if (!pointOk(s, o)) {
+        o.text = 'Bloquer une rue';
+        return finish(o, key);
+      }
+      address(s, o, `Bloquer ${placeWithArticle(road.name)}`, true);
+      if (o.enabled && d > RANGE.send) lockWith(o, REFUS.tropLoin, SECTOR_LOCKS.tropLoin);
+      return finish(o, key);
+    }
+    case 'interpeller': {
+      const person = des.kind === 'person' && des.person && des.person.kind !== 'police' ? des.person : null;
+      if (!person) {
+        const o = blank('c', 'interpeller', x, z, d);
+        o.orderType = 'interpeller';
+        o.text = 'Interpeller';
+        lockWith(o, SECTOR_REFUS.visezQuelquun, SECTOR_LOCKS.visezQuelquun);
+        return finish(o, key);
+      }
+      if (person.kind === 'offender') {
+        const o = blank('c', 'interpeller', x, z, d);
+        o.orderType = 'interpeller';
+        o.intent = 'interpeller';
+        o.targetId = person.id;
+        o.personId = person.id;
+        address(s, o, `Interpeller ${person.label}`, true);
+        if (o.enabled && d > RANGE.send) lockWith(o, REFUS.tropLoin, SECTOR_LOCKS.tropLoin);
+        return finish(o, key);
+      }
+      // personne n'a rien commis : l'unité va constater et surveille (la fiche de la carte dit la même chose)
+      const o = blank('c', 'constater', x, z, d);
+      o.orderType = 'interpeller';
+      o.intent = 'interpeller';
+      o.personId = person.id;
+      address(s, o, VERB_WORDS.constater.label, true);
+      if (o.enabled && d > RANGE.send) lockWith(o, REFUS.tropLoin, SECTOR_LOCKS.tropLoin);
+      return finish(o, key);
+    }
+    case 'disperser': {
+      const crowd = s.env.demonstratorsAt(x, z, SECTOR_CROWD_RADIUS);
+      const o = blank('f', 'disperser', x, z, d);
+      o.orderType = 'refoulement';
+      o.intent = 'disperser';
+      if (s.des.kind === 'none' || crowd.count < RANGE.crowdMin) {
+        o.text = 'Disperser';
+        lockWith(o, SECTOR_REFUS.visezFoule, SECTOR_LOCKS.visezFoule);
+        return finish(o, key);
+      }
+      o.place = placeOf(s, x, z);
+      address(s, o, 'Disperser la foule', false);
+      if (o.enabled && d > RANGE.send) lockWith(o, REFUS.tropLoin, SECTOR_LOCKS.tropLoin);
+      forceLock(s, o, 'refoulement');
+      if (o.legalFirst) o.text = 'Disperser : sommations d’abord';
+      return finish(o, key);
+    }
+    case 'repli':
+    case 'tenir':
+    case 'cesser':
+    case 'libre':
+    case 'tortue': {
+      const type = sector.orders[0]!;
+      const verb = sector.action;
+      const o = blank('h', verb, x, z, d);
+      o.orderType = type;
+      // le point de l'ordre : l'unité elle-même (sur place) ; le repli, 30 m derrière elle, à l'opposé du regard
+      const who = resolveWho(s.env, s.whoKey, verb, x, z);
+      const u = who && who.squadIds.length > 0 ? s.env.units.find((q) => q.squadId === who.squadIds[0]) : undefined;
+      const p = s.env.player;
+      const ux = u ? u.x : p ? p.x : x, uz = u ? u.z : p ? p.z : z;
+      o.x = verb === 'repli' ? ux - Math.sin(s.yaw) * REPLI_DISTANCE : ux;
+      o.z = verb === 'repli' ? uz - Math.cos(s.yaw) * REPLI_DISTANCE : uz;
+      o.heading = s.yaw;
+      o.distance = p ? Math.hypot(o.x - p.x, o.z - p.z) : 0;
+      // l'unité est celle de l'ordre prêt au point désigné (le repli n'en choisit pas une autre, plus près de l'arrière)
+      address(s, o, VERB_WORDS[verb].label, false, { x, z });
+      return finish(o, key);
+    }
+    case 'bond':
+    case 'charge':
+    case 'gaz':
+    case 'pousser': {
+      const type = sector.orders[0]!;
+      const o = blank('h', sector.action, x, z, d);
+      o.orderType = type;
+      if (!pointOk(s, o)) {
+        o.text = VERB_WORDS[sector.action].label;
+        return finish(o, key);
+      }
+      o.place = placeOf(s, x, z);
+      address(s, o, VERB_WORDS[sector.action].label, true);
+      if (o.enabled && d > RANGE.send) lockWith(o, REFUS.tropLoin, SECTOR_LOCKS.tropLoin);
+      forceLock(s, o, type);
+      return finish(o, key);
+    }
+    default:
+      return null;
+  }
+}
+
+/** Deuxième ligne d'un secteur : l'unité qui obéira, ou la raison du verrou en quelques mots. */
+export function sectorItemText(o: NaturalOrder | null, fallback: string): string {
+  if (!o) return fallback;
+  return o.whoShort !== '' ? o.whoShort : fallback;
+}
+
+/** Le secteur est-il grisé (verrou, rien à viser, personne) ? Un secteur `legalFirst` est grisé mais se choisit. */
+export function sectorLocked(o: NaturalOrder | null): boolean {
+  return o !== null && (!o.enabled || o.legalFirst);
+}
diff --git a/crs-simulation/src/ui/command/direct/state.ts b/crs-simulation/src/ui/command/direct/state.ts
new file mode 100644
index 0000000..e1346f1
--- /dev/null
+++ b/crs-simulation/src/ui/command/direct/state.ts
@@ -0,0 +1,136 @@
+/* =====================================================================================
+ * Ordres directs — LA LIGNE D'UNE UNITÉ (puce d'état, bloc d'ordres) : « QUI · QUOI · pour qui / où » (logique pure).
+ *
+ *   unitLine(instantané)        jamais « sans ordre » pour une unité sous ses ordres (§3.2) :
+ *     suit le joueur, il marche          « AVEC VOUS · vous suivent »
+ *     il s'est arrêté 3 s, foule ≤ 120 m « AVEC VOUS · en ligne face à la foule »
+ *     il s'est arrêté, pas de foule      « AVEC VOUS · en garde autour de vous »
+ *     « Avec moi » en véhicules          « AVEC VOUS · montent dans les fourgons (14/19) » / « … en colonne derrière vous »
+ *     autre ordre du joueur              le ticket, puis l'étiquette (« MISTRAL 2 · barre rue de Rivoli »)
+ *     « Laisser agir seuls »             « MISTRAL 2 · agissent seuls »
+ *     interpellation / secours finis     « BRAV-M · revient avec vous »
+ *     Envoyer fini                       « FAUCON 1 · au carrefour Voltaire · attend vos ordres »
+ *   groupSummary(unités, posture)  « AVEC VOUS · 3 sections + BRAV-M · en ligne face à la foule ».
+ *   NO_ORDER_TAG « SANS ORDRE » ne sert qu'aux unités que le joueur ne commande pas.
+ * ===================================================================================== */
+
+import type { Ticket } from './tickets';
+import { ticketText } from './tickets';
+import type { DirectVerb } from './types';
+import { VERB_WORDS, atPlace } from './words';
+
+export const AVEC_VOUS = 'AVEC VOUS';
+export const NO_ORDER_TAG = 'SANS ORDRE';
+/** Le joueur est « arrêté » après 3 s sur place ; une foule compte jusqu'à 120 m. */
+export const STOP_TIME = 3;
+export const CROWD_NEAR = 120;
+
+/** Posture de « Avec moi » quand le joueur est à pied (P2 la donne dans la simulation, sans ordre). */
+export type FollowPosture = 'suivent' | 'face_foule' | 'en_garde';
+
+/** Ce que la puce lit d'une unité à cet instant. */
+export interface UnitLineSnapshot {
+  name: string;
+  /** Sous les ordres du joueur. */
+  commanded: boolean;
+  /** Ordre du joueur en cours ou dernier (null : aucun) et son lieu sans article. */
+  playerVerb: DirectVerb | null;
+  place: string;
+  /** L'ordre du joueur est terminé (« ✓ » montré, puis l'étiquette). */
+  done: boolean;
+  /** Ticket vivant (reçu → en place, 6 s), null sinon. */
+  ticket: Ticket | null;
+  /** L'unité suit le joueur (« Avec moi »). */
+  followsPlayer: boolean;
+  /** « Avec moi » quand le joueur est en véhicule : montée (assis / total) ou colonne derrière lui. */
+  vehicles: { boarded: number; total: number; driving: boolean } | null;
+  /** Le joueur marche ; arrêté depuis (s) ; une foule à moins de 120 m. */
+  playerMoving: boolean;
+  playerStoppedFor: number;
+  crowdNear: boolean;
+  /** Retour vers le joueur après une interpellation ou un secours terminés. */
+  returning: boolean;
+  /** Étiquette de l'ordre de la simulation pour une unité que le joueur ne commande pas (« TIENT »), '' sinon. */
+  simTag: string;
+}
+
+/** Posture affichée d'une unité qui suit le joueur à pied. */
+export function followPosture(s: Pick<UnitLineSnapshot, 'playerMoving' | 'playerStoppedFor' | 'crowdNear'>): FollowPosture {
+  if (s.playerMoving || s.playerStoppedFor < STOP_TIME) return 'suivent';
+  return s.crowdNear ? 'face_foule' : 'en_garde';
+}
+
+const POSTURE_WORDS: Readonly<Record<FollowPosture, string>> = {
+  suivent: 'vous suivent', face_foule: 'en ligne face à la foule', en_garde: 'en garde autour de vous',
+};
+
+/** Ce que fait l'unité après un ordre du joueur terminé (« barre rue de Rivoli », « tient sa position »). */
+export function orderTag(verb: DirectVerb, place: string): string {
+  const w = VERB_WORDS[verb];
+  switch (verb) {
+    case 'bloquer':
+      return place !== '' ? `${w.doing} ${place}` : 'barre la rue';
+    case 'envoyer':
+    case 'venir':
+      return `${place !== '' ? atPlace(place) : 'sur le point'} · attend vos ordres`;
+    case 'face_foule':
+    case 'tenir':
+    case 'tortue':
+    case 'libre':
+    case 'cesser':
+      return w.doing;
+    default:
+      return place !== '' && w.doing !== '' ? `${w.doing} · ${place}` : w.doing;
+  }
+}
+
+/** La ligne d'une unité (§3.2). */
+export function unitLine(s: UnitLineSnapshot): string {
+  if (!s.commanded) return `${s.name} · ${s.simTag !== '' ? s.simTag : NO_ORDER_TAG}`;
+  if (s.ticket && s.ticket.state !== 'remplace') return ticketText(s.ticket);
+  if (s.returning) return `${s.name} · revient avec vous`;
+  if (s.followsPlayer || s.playerVerb === 'avec_moi') {
+    const v = s.vehicles;
+    if (v) return v.driving ? `${AVEC_VOUS} · en colonne derrière vous` : `${AVEC_VOUS} · montent dans les fourgons (${v.boarded}/${v.total})`;
+    return `${AVEC_VOUS} · ${POSTURE_WORDS[followPosture(s)]}`;
+  }
+  if (s.playerVerb === 'libre') return `${s.name} · agissent seuls`;
+  if (s.playerVerb !== null && s.playerVerb !== 'rien') return `${s.name} · ${orderTag(s.playerVerb, s.place)}`;
+  return `${s.name} · attend vos ordres`;
+}
+
+/** Unité comptée dans le résumé du groupe « avec vous ». */
+export interface SummaryUnit {
+  symbol: string;
+  avecVous: boolean;
+}
+
+const COUNT_WORDS: readonly { symbol: string; one: string; many: string }[] = [
+  { symbol: 'section', one: 'section', many: 'sections' },
+  { symbol: 'groupe', one: 'groupe', many: 'groupes' },
+  { symbol: 'binome', one: 'binôme', many: 'binômes' },
+  { symbol: 'bravm', one: 'BRAV-M', many: 'BRAV-M' },
+  { symbol: 'centaure', one: 'Centaure', many: 'Centaures' },
+  { symbol: 'canon_eau', one: 'canon à eau', many: 'canons à eau' },
+  { symbol: 'drone', one: 'drone', many: 'drones' },
+  { symbol: 'patrouille', one: 'patrouille', many: 'patrouilles' },
+];
+
+/** « 3 sections + BRAV-M » : les unités avec le joueur, par genre (la BRAV-M sans nombre). */
+export function countText(units: readonly SummaryUnit[]): string {
+  const parts: string[] = [];
+  for (const w of COUNT_WORDS) {
+    const n = units.filter((u) => u.avecVous && u.symbol === w.symbol).length;
+    if (n === 0) continue;
+    if (w.symbol === 'bravm') parts.push('BRAV-M');
+    else parts.push(n === 1 ? `1 ${w.one}` : `${n} ${w.many}`);
+  }
+  return parts.join(' + ');
+}
+
+/** « AVEC VOUS · 3 sections + BRAV-M · en ligne face à la foule » ; '' si personne n'est avec lui. */
+export function groupSummary(units: readonly SummaryUnit[], posture: FollowPosture): string {
+  const c = countText(units);
+  if (c === '') return '';
+  return `${AVEC_VOUS} · ${c} · ${POSTURE_WORDS[posture]}`;
+}
