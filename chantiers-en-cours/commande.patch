+  const w = plainOf(type);
+  if (!w) return '';
+  const p = place.trim();
+  let text: string;
+  const street = STREET_DOING[String(type)];
+  if (street && p !== '') text = `${street} ${withArticle(p)}${type === 'couper_circulation' && targetId === BARRAGE_LET_PASSERSBY ? ', passants admis' : ''}`;
