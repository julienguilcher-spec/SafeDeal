+      expect(mhost.all('button').filter((b) => b.dataset.n !== undefined).length).toBe(0);
+      expect(mhost.all('button').filter((b) => b.dataset.id?.startsWith('verb-')).length).toBe(ORDER_VERBS.length);
+      const input = mhost.querySelector('input')!;
