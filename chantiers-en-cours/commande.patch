+
+/** « jusqu’à la rue », « jusqu’au boulevard », « jusqu’à ce point ». */
+function untilOf(p: string): string {
+  if (p.startsWith('le ')) return 'jusqu’au ' + p.slice(3);
+  if (p.startsWith('les ')) return 'jusqu’aux ' + p.slice(4);
+  return 'jusqu’à ' + p;
