+  b.appendChild(key);
+  if (opts.title) b.title = opts.title;
+  if (opts.id) b.dataset.id = opts.id;
+  b.addEventListener('click', (e) => {
+    e.stopPropagation();
+    onClick();
+  });
+  return { btn: b, label: lg, key };
