+  C.check(await page.evaluate(() => { const t = window.__CRS.game.systems.find((s) => s.id === 'ui:command').tactical; return !!t && t.state.sheet === 'none'; }), 'retour au repos');
+
+  // ── T3 : N, Entrée ──
