+  C.check(keys <= 3, `T1 : ${keys} touches carte ouverte (§4 : 4 avec Tab)`);
+  const t1c = await tac();
+  C.check(t1c.intent === 'bloquer' && t1c.candIndex === 1, 'B reste actif : la visée est sur la rue suivante', JSON.stringify(t1c));
+  // deux Entrée de suite : un seul ordre
