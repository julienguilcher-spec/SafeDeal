+    case 'assignOther':
+    case 'metro':
+      p.kind = who && who.squadIds.length > 0 ? 'arrows' : 'none';
+      p.arrows = arrowsTo(env, who, where.x, where.z);
+      return p;
+    default:
+      return p;
+  }
+}
