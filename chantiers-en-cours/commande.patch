+  C.check(t1 && !/^Passage piéton$/i.test(t1.visee || ''), 'B : la rue proposée a un vrai nom', t1 && t1.visee);
+  await snap(page, 'commande-S1-1280x800');
+  // S2 : Maj + Entrée ouvre la liste Qui ; Échap y revient
